@model ShoppingCartModel

@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Orders
@using Nop.Core.Domain.Tax
@using Nop.Services.Configuration
@using Nop.Services.Customers

@inject IWebHelper webHelper
@inject IWorkContext workContext
@inject OrderSettings orderSettings
@inject ISettingService settingService
@inject ICustomerService customerService
@{
    bool isOnePageCheckout = ViewContext.RouteData.Values["Controller"]?.ToString() == "DelsamiCheckout"
             && ViewContext.RouteData.Values["Action"]?.ToString() == "OpcSavePaymentMethod";

    var bwdkEnabled = settingService.GetSettingByKey<bool>
    ("digikalashoppingsettings.enabled");
    var restrictedRoles = settingService.GetSettingByKey<string>
        ("digikalashoppingsettings.SelectedRestrictRoleIds")
        ?.Split("-")
        ?.Select(a => int.Parse(a))
        .ToList() ?? new(); ;

        var customer = await workContext.GetCurrentCustomerAsync();
        var customerRoleIds = await customerService.GetCustomerRoleIdsAsync(customer);

        var isRestricted = customerRoleIds.Any(x => restrictedRoles.Contains(x));
        }
        <style>
            .divider {
                position: relative;
                text-align: center;
                margin: 15px 0;
            }

                .divider::before {
                    content: "";
                    position: absolute;
                    top: 50%;
                    left: 0;
                    width: 100%;
                    height: 1px;
                    background: #ddd;
                    transform: translateY(-50%);
                }

                .divider span {
                    position: relative;
                    background: #fbfbfb;
                    padding: 0 8px;
                    color: #999;
                    font-size: 14px;
                }
        </style>
        <script src="https://digifycdn.com/front-statics/digify-bwdk-ui-kit/widget-sdk.min.js" Data-digify-widget async></script>
        <div class="order-summary-content">
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OrderSummaryContentBefore, additionalData = Model })
            @await Html.PartialAsync("_OrderReviewData", Model.OrderReviewData)
            @if (Model.Items.Count > 0)
            {
            if (Model.Warnings.Count > 0)
            {
            <div class="message-error">
                <ul>
                    @foreach (var warning in Model.Warnings)
                    {
                    <li>@warning</li>
                    }
                </ul>
            </div>
            }
            @*we add enctype = "multipart/form-data" because "File upload" attribute control type requires it*@
            <form asp-route="ShoppingCart" method="post" enctype="multipart/form-data" id="shopping-cart-form">
                <div class="cart-wrapper">
                    <div class="">
                        <div class="row">
                            <div class="col-12 col-md-8">
                                @if (bwdkEnabled && !isRestricted)
                                {
                                <div class="cart">
                                    <digify-clickable-box id="widget"></digify-clickable-box>
                                </div>
                                <script>

                                    (() => {

                                        const widgetElement = document.getElementById("widget");

                                        // Prevent duplicate event registration
                                        if (widgetElement && !widgetElement.dataset.orderEventBound) {

                                            widgetElement.dataset.orderEventBound = "true";

                                            widgetElement.addEventListener("click", async () => {

                                                // Prevent double submission
                                                if (widgetElement.dataset.submitting === "true")
                                                    return;

                                                widgetElement.dataset.submitting = "true";

                                                try {
                                                    const response = await fetch(
                                                        "/DigiKalaShopping/CreateOrder"
                                                    );

                                                    if (!response.ok) {
                                                        alert("خطا در ثبت سفارش با دیجی کالا");
                                                        return;
                                                    }

                                                    const dataJson = await response.json();

                                                    if (!dataJson.isSuccess) {
                                                        alert(dataJson.message);
                                                        return;
                                                    }

                                                    window.location.href = dataJson.data;

                                                } catch (error) {

                                                    console.error("CreateOrder error:", error);
                                                    alert("خطایی در ارتباط با سرور رخ داد");

                                                } finally {

                                                    delete widgetElement.dataset.submitting;

                                                }
                                            });
                                        }

                                        // Initialize Digify Widget
                                        const initWidget = () => {

                                            const widget = window.DigifyWidget?.default;

                                            if (!widget?.init) {
                                                console.error("Digify widget SDK failed to load");
                                                return;
                                            }

                                            widget.init();
                                        };

                                        if (window.DigifyWidget?.default?.init) {

                                            initWidget();

                                        } else {

                                            const sdkScript = document.querySelector(
                                                "script[data-digify-widget]"
                                            );

                                            if (sdkScript) {
                                                sdkScript.addEventListener(
                                                    "load",
                                                    initWidget,
                                                    { once: true }
                                                );
                                            }
                                        }

                                    })();

                                </script>
                                }


