        <script asp-location="Footer">


            function updateCartItemQuantityTotal() {
                let cartItemQuantityTotal = 0;
                jQuery('.cart-item .quantity input.qty-input').each(function (i, e) {
                    cartItemQuantityTotal += Number(jQuery(this).val());
                })

                jQuery('.header-cart-mobile a.ico-cart span.cart-qty-in').html(cartItemQuantityTotal);

                if (cartItemQuantityTotal <= 0) {
                    jQuery('.header-cart-mobile a.ico-cart span.cart-qty-in').remove();
                    jQuery('.header-cart-mobile a.ico-cart img').attr('src', '/icons/Delsami-icon-pack/Cart-Empty.svg');
                }

            }

            function removeItem(productId, itemId) {
                if (!productId) return;

                var postData = {
                    productId: productId,
                    quantity: 0
                };

                addAntiForgeryToken(postData);

                $.ajax({
                    cache: false,
                    type: "POST",
                    url: "@Url.RouteUrl("UpdateQuantity")",
                    data: postData,
                    dataType: "json",
                    beforeSend: function () {
                        $("#itemquantity" + itemId).css("display", "none");
                        $("#itemquantity" + itemId).prop("disabled", "disabled");
                        $("#dots-spinner" + itemId).css("display", "inline-block")
                        $(".decrease-quantity" + itemId).prop("disabled", "disabled");
                        $(".increase-quantity" + itemId).prop("disabled", "disabled");
                        $(".remove-btn" + itemId).prop("disabled", "disabled");
                    },
                    success: function (data, textStatus, jqXHR) {
                        if (data.IsSucceed) {
                            $(".total-info").html(data.OrderTotals);
                            $(".cart-qty").text(data.TotalQuantity);
                            $("#flyout-cart").replaceWith(data.FlayoutShopping);

                            updateCartItemQuantityTotal();

                            $("#itemquantity" + itemId).closest(".cart-item .item-image-quantity-details").animate({ height: 0, opacity: 0 }, function () {
                                $("#itemquantity" + itemId).closest('.cart-item').remove();

                                if (jQuery('div.cart.footable-loaded.footable .cart-item').length <= 0) {
                                    jQuery('.header-cart-button-mobile').remove();
                                    window.location.reload();
                                }
                            });

                        } else {
                            $("#itemquantity" + itemId).val(Number($("#itemquantity" + itemId).val()) + Number(1));
                            data.Warnings.forEach(function (warning) { alert(warning) });
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        $("#itemquantity" + itemId).val(Number($("#itemquantity" + itemId).val()) + Number(1));

                        alert('@T("Delsami.Plugin.Misc.ShoppingCartPage.ErrorOccuredInDecreasing")');
                    },
                    complete: function () {

                        setTimeout(function () {
                            $("#itemquantity" + itemId).css("display", "inline-block");
                            $("#itemquantity" + itemId).prop("disabled", "");
                            $("#dots-spinner" + itemId).css("display", "none")
                            $(".decrease-quantity" + itemId).prop("disabled", "");
                            $(".increase-quantity" + itemId).prop("disabled", "");
                            $(".remove-btn" + itemId).prop("disabled", "");

                        }, 500);
                    },
                });

            }

        </script>
