@model PaymentResultModel

@{
    Layout = "_ColumnsOne";
}

<table width="100%" cellpadding="0" cellspacing="0">
    <tr>
        <td>
            @{
                if (Model.IsSucessful)
                {
                    <span>
                        @T("IFC.Payments.DigiPay.PaymentWasSuccessful")
                    </span>
                    <br />
                    <span>
                        @T("IFC.Payments.DigiPay.TrackingCode") @Model.TrackingCode
                    </span>
                }
                else
                {
                    <span>
                        @T("IFC.Payments.DigiPay.PaymentWasFailed")
                    </span>
                    <br />

                    if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <span>
                            @T("IFC.Payments.DigiPay.Message") @Model.Message
                        </span>
                    }


                    if (!string.IsNullOrEmpty(Model.TrackingCode))
                    {
                        <span>
                            @T("IFC.Payments.DigiPay.TrackingCode") @Model.TrackingCode
                        </span>
                    }
                }
            }
        </td>
    </tr>
</table>
