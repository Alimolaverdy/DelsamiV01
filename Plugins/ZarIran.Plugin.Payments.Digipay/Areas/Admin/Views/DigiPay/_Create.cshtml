@using ZarIran.Plugin.Payments.Digipay.Areas.Admin.Models.DigiPayRefund
@model DigiPayRefundModel

<form asp-controller="DigiPayRefund" asp-action="CreateRefundRecord" method="post">
		<div class="container-fluid">
			<div class="form-horizontal pt-3">
				<div class="cards-group">
					<div class="card card-default">
						<div class="card-header">
							<h3>@T("ZarIran.Plugin.payments.Digipay.Refund.Title")</h3>
						</div>

						<div class="card-body">

							<div class="form-group row">
								<div class="col-md-3">
									<nop-label asp-for="PaymentTrackingCode" />
								</div>

								<div class="col-md-5">
								<nop-editor asp-for="PaymentTrackingCode" asp-required="true" />
								<span asp-validation-for="PaymentTrackingCode"></span>
								</div>
							</div>


							<div class="form-group row">
								<div class="col-md-3">
									<nop-label asp-for="Amount" />
								</div>

								<div class="col-md-5">
									<nop-editor asp-for="Amount" asp-required="true" />
									<span asp-validation-for="Amount"></span>
								</div>
							</div>

							<div class="form-group row">
								<div class="col-md-3">
									<nop-label asp-for="PaymentType" />
								</div>

								<div class="col-md-5">

									<nop-select asp-for="PaymentType" asp-items="Html.GetEnumSelectList<PaymentType>()" asp-required="true" />
									<span asp-validation-for="PaymentType"></span>

								</div>
							</div>

							<div class="form-group row">
								<div class="col-md-9 offset-3">
								<input type="submit" name="save" class="btn bg-green" value="@T("ZarIran.Plugin.payments.Digipay.Refund.ButtonText")" />
								</div>
							</div>

						</div>
					</div>
				</div>
			</div>
		</div>
</form>