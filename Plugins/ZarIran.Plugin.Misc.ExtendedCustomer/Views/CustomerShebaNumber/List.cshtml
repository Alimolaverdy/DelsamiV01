@model CustomerShebaNumberListModel

@{
    Layout = "_ColumnsTwo";

    //title
    NopHtml.AddTitleParts(T("PageTitle.Account").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-address-list-page");
}

@section left
{
    @await Component.InvokeAsync(typeof(CustomerNavigationViewComponent), new { selectedTabId = ZarIranCustomerNavigationEnum.CustomerShebaNumbers })
}

<div class="page account-page sheba-list-page">
    <div class="page-title">
        <h1>@T("ZarIran.Plugin.Misc.ExtendedCustomer.Account.CustomerShebaNumbers")</h1>
    </div>
    <div class="page-body">
        @if (Model.CustomerShebaNumbers.Count > 0)
        {
            <div class="sheba-list">
                @for (var i = 0; i < Model.CustomerShebaNumbers.Count; i++)
                {
                    var customerShebaNumber = Model.CustomerShebaNumbers[i];
                    <div class="section sheba-item">
                        <ul class="info">

                            <li>
                                <label>@T("ZarIran.Plugin.Misc.ExtendedCustomer.CustomerShebaNumber.Number"):</label>
                                @customerShebaNumber.Number
                            </li>

                        </ul>
                        <div class="buttons">
                            <button type="button" class="button-2 edit-sheba-button" onclick="location.href = '@(Url.RouteUrl("CustomerShebaNumberEdit", new {id = customerShebaNumber.Id}))'">@T("Common.Edit")</button>

                            <button type="button" class="button-2 delete-sheba-button" onclick="deletecustomercar(@(customerShebaNumber.Id))">@T("Common.Delete")</button>
                        </div>
                    </div>
                }
            </div>

            <div class="add-button">
                <button type="button" class="button-1 add-address-button" onclick="location.href='@Url.RouteUrl("CustomerShebaNumberCreate")'">@T("Common.AddNew")</button>
            </div>
            <script asp-location="Footer">
                function deletecustomercar(id) {
                    if (confirm('@T("Common.AreYouSure")')) {
                        var postData = {
                            id: id
                        };
                        addAntiForgeryToken(postData);

                        $.ajax({
                            cache: false,
                            type: "POST",
                            url: "@Url.Action("Delete", "CustomerShebaNumber")",
                            data: postData,
                            dataType: "json",
                            success: function (data, textStatus, jqXHR) {
                                location.href = data.redirect;
                            },
                            error: function (jqXHR, textStatus, errorThrown) {
                                alert('Failed to delete');
                            }
                        });
                    }
                }
            </script>
        }
        else
        {
            <div class="no-data">
                <img src="/images/Empty-Basket.svg" />
                @T("ZarIran.Plugin.Misc.ExtendedCustomer.Account.CustomerShebaNumbers.NoSheba")
                <div class="add-button">
                    <button type="button" class="button-1 add-address-button" onclick="location.href='@Url.RouteUrl("CustomerShebaNumberCreate")'">@T("Common.AddNew")</button>
                </div>
            </div>
            
        }

    </div>
</div>