@model CustomerShebaNumberModel
@{
    Layout = "_ColumnsTwo";

    //title
    NopHtml.AddTitleParts(T("PageTitle.Account").Text);
    NopHtml.AppendPageCssClassParts("html-account-page");
    //page class
    NopHtml.AppendPageCssClassParts("html-sheba-edit-page");
}
@section left
{
    @await Component.InvokeAsync(typeof(CustomerNavigationViewComponent), new { selectedTabId = 160 })
}
<form asp-route="CustomerShebaNumberEdit" method="post">
    <div class="page account-page sheba-edit-page">
        <div class="page-title">
            <h1>@T("Account.MyAccount") - @T("ZarIran.Plugin.Misc.ExtendedCustomer.Account.CustomerShebaNumbers.Edit")</h1>
        </div>
        <div class="page-body">
            <div asp-validation-summary="ModelOnly" class="message-error"></div>
            @{
                @await Html.PartialAsync("~/Plugins/ZarIran.Misc.ExtendedCustomer/Views/CustomerShebaNumber/_CreateOrUpdate.cshtml", Model)
            }
            <div class="buttons">
                <button type="submit" class="button-1 save-sheba-button">@T("Common.Save")</button>
            </div>
        </div>
    </div>
</form>