@model CarBrandModelRelationModel

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="CarBrandSpecificationAttributeOptionId" />
                            </div>
                            <div class="col-md-9">
                                <nop-select asp-for="CarBrandSpecificationAttributeOptionId" asp-items="Model.AvailableCarBrandSpecificationAttributeOptions" asp-required="true" />
                                <span asp-validation-for="CarBrandSpecificationAttributeOptionId"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="ModelSpecificationAttributeOptionId" />
                            </div>
                            <div class="col-md-9">
                                <nop-select asp-for="ModelSpecificationAttributeOptionId" asp-items="Model.AvailableModelSpecificationAttributeOptions" asp-required="true" />
                                <span asp-validation-for="ModelSpecificationAttributeOptionId"></span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
