@model CarBrandModelRelationModel

@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("NobParts.Plugin.Misc.CarInfo.CarBrandModelRelationModel.Edit").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName(T("NobParts.Plugin.Misc.CarInfo.CarBrandModelRelationModel.List.SystemName").Text);
}

<form asp-controller="CarBrandModelRelation" asp-action="Edit" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("NobParts.Plugin.Misc.CarInfo.CarBrandModelRelation.Edit")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">@T("NobParts.Plugin.Misc.CarInfo.CarBrandModelRelation.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
           
            <span id="car-brand-model-delete" class="btn btn-danger">
                <i class="far fa-trash-alt"></i>
                @T("Admin.Common.Delete")
            </span>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/NobParts.Misc.CarInfo/Areas/Admin/Views/CarBrandModelRelation/_CreateOrUpdate.cshtml", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="car-brand-model-delete" />