@model CustomerCarListModel
@{
    Layout = "_ColumnsTwo";

    //title
    NopHtml.AddTitleParts(T("PageTitle.Account").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-address-list-page");
}
@section left
    {
    @await Component.InvokeAsync(typeof(CustomerNavigationViewComponent), new { selectedTabId = /*CustomerNavigationEnum.Addresses*/150 })
}
<div class="page account-page address-list-page">
    <div class="page-title">
        <h1>@T("Account.MyAccount") - @T("NobParts.Plugin.Misc.CarInfo.Account.CustomerCars")</h1>
    </div>
    <div class="page-body">
        @if (Model.CustomerCars.Count > 0)
        {
            <div class="address-list">
                @for (var i = 0; i < Model.CustomerCars.Count; i++)
                {
                    var customerCar = Model.CustomerCars[i];
                    <div class="section address-item">
                        <ul class="info">

                            <li>
                                <label>@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.ManufacturerId"):</label>
                                @customerCar.ManufacturerName
                            </li>

                            <li>
                                <label>@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.ModelSpecificationAttributeOptionId"):</label>
                                @customerCar.ModelSpecificationAttributeOptionName
                            </li>

                            <li>
                                <label>@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.YearSpecificationAttributeOptionId"):</label>
                                @customerCar.YearSpecificationAttributeOptionName
                            </li>

                            <li>
                                <label>@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.LicencePlate"):</label>
                                @customerCar.IranNumberLicencePlate ایران  @customerCar.ThreeRighNumberLicencePlate   @customerCar.AlphabetLicencePlateStr @customerCar.TwoLeftNumberLicencePlate
                            </li>

                            <li>
                                <label>@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.ThirdPartyInsurancePolicyNumber"):</label>
                                @customerCar.ThirdPartyInsurancePolicyNumber
                            </li>

                            <li>
                                <label>@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.ThirdPartyInsurancePolicyExpirationDate"):</label>
                                @customerCar.ThirdPartyInsurancePolicyExpirationDateStr
                            </li>

                            <li>
                                <label>@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.BodyInsurancePolicyNumber"):</label>
                                @customerCar.BodyInsurancePolicyNumber
                            </li>

                            <li>
                                <label>@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.BodyInsurancePolicyExpirationDate"):</label>
                                @customerCar.BodyInsurancePolicyExpirationDateStr
                            </li>


                            <li>
                                <label>@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.VinNumber"):</label>
                                @customerCar.VinNumber
                            </li>

                        </ul>
                        <div class="buttons">
                            <button type="button" class="button-2 edit-address-button" onclick="location.href = '@(Url.RouteUrl("CustomerCarEdit", new {id = customerCar.Id}))'">@T("Common.Edit")</button>

                            <button type="button" class="button-2 delete-address-button" onclick="deletecustomercar(@(customerCar.Id))">@T("Common.Delete")</button>
                        </div>
                    </div>
                }
            </div>
            <script asp-location="Footer">
                function deletecustomercar(id) {
                    if (confirm('@T("Common.AreYouSure")')) {
                        var postData = {
                            id: id
                        };
                        addAntiForgeryToken(postData);

                        $.ajax({
                            cache: false,
                            type: "POST",
                            url: "@Url.Action("Delete", "CustomerCar")",
                            data: postData,
                            dataType: "json",
                            success: function (data, textStatus, jqXHR) {
                                location.href = data.redirect;
                            },
                            error: function (jqXHR, textStatus, errorThrown) {
                                alert('Failed to delete');
                            }
                        });
                    }
                }
            </script>
        }
        else
        {
            <div class="no-data">
                @T("NobParts.Plugin.Misc.CarInfo.Account.NoCustomerCars")
            </div>
        }
        <div class="add-button">
            <button type="button" class="button-1 add-address-button" onclick="location.href='@Url.RouteUrl("CustomerCarAdd")'">@T("Common.AddNew")</button>
        </div>
    </div>
</div>