@model CustomerCarModel

<link href="~/plugins/NobParts.Misc.CarInfo/content/lib/persiandatepicker/persiandatepicker-default.css" rel="stylesheet" />
<script src="~/plugins/NobParts.Misc.CarInfo/content/lib/persiandatepicker/persiandatepicker.min.js"></script>
<link href="~/Plugins/NobParts.Misc.CarInfo/Content/style.css" rel="stylesheet" />

<input class="customercar-id" asp-for="Id" type="hidden" />
<div class="edit-car">
    <div class="inputs">
        <label asp-for="CarBrandSpecificationAttributeOptionId" asp-postfix=":"></label>
        <select asp-for="CarBrandSpecificationAttributeOptionId" asp-items="Model.AvailableCarBrandSpecificationAttributeOptions">
            <option value="">@T("NobParts.Plugin.Misc.CarInfo.CarBrand.SelectDefaultOptionText")</option>
        </select>
        <nop-required />
        <span asp-validation-for="CarBrandSpecificationAttributeOptionId"></span>
    </div>

    <div class="inputs">
        <label asp-for="ModelSpecificationAttributeOptionId" asp-postfix=":"></label>
        <select asp-for="ModelSpecificationAttributeOptionId" disabled>
        </select>
        <nop-required />
        <span asp-validation-for="ModelSpecificationAttributeOptionId"></span>
    </div>

    <div class="inputs">
        <label asp-for="YearSpecificationAttributeOptionId" asp-postfix=":"></label>
        <select asp-for="YearSpecificationAttributeOptionId" disabled>
        </select>
        <span asp-validation-for="YearSpecificationAttributeOptionId"></span>
    </div>

    <div class="inputs">
        <label>@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.LicencePlate")</label>

        <div class="plate-input">
            <input class="int-input" asp-for="IranNumberLicencePlate" placeholder="@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.IranNumberLicencePlate")" value="@Model.IranNumberLicencePlate" />
        </div>

        <div class="plate-input">
            <input class="int-input" asp-for="ThreeRighNumberLicencePlate" placeholder="@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.ThreeRighNumberLicencePlate")" value="@Model.ThreeRighNumberLicencePlate" />
        </div>

        <div class="plate-input">
            <select asp-for="AlphabetLicencePlate" asp-items="Model.AvailableAlphabetLicencePlates">
                <option value="">@T("NobParts.Plugin.Misc.CarInfo.AlphabetLicencePlate.SelectDefaultOptionText")</option>
            </select>
        </div>

        <div class="plate-input">
            <input class="int-input" asp-for="TwoLeftNumberLicencePlate" placeholder="@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.TwoLeftNumberLicencePlate")" value="@Model.TwoLeftNumberLicencePlate" />
        </div>
        <span asp-validation-for="TwoLeftNumberLicencePlate"></span>
        <span asp-validation-for="AlphabetLicencePlate"></span>
        <span asp-validation-for="ThreeRighNumberLicencePlate"></span>
        <span asp-validation-for="IranNumberLicencePlate"></span>
    </div>

    <div class="inputs">
        <label asp-for="VinNumber" asp-postfix=":"></label>
        <input asp-for="VinNumber" />
        <span asp-validation-for="VinNumber"></span>
    </div>

    <div class="inputs">
        <label asp-for="ThirdPartyInsurancePolicyNumber" asp-postfix=":"></label>
        <input asp-for="ThirdPartyInsurancePolicyNumber" />
        <span asp-validation-for="ThirdPartyInsurancePolicyNumber"></span>
    </div>

    <div class="inputs">
        <label asp-for="BodyInsurancePolicyNumber" asp-postfix=":"></label>
        <input asp-for="BodyInsurancePolicyNumber" />
        <span asp-validation-for="BodyInsurancePolicyNumber"></span>
    </div>

    <div class="inputs">
        <label asp-for="Kilometers" asp-postfix=":"></label>
        <input asp-for="Kilometers" />
        <span asp-validation-for="Kilometers"></span>
    </div>

    <div class="inputs">
        <label asp-for="KilometerRegistrationDateTimeStr" asp-postfix=":"></label>
        <input asp-for="KilometerRegistrationDateTimeStr" />
        <span asp-validation-for="KilometerRegistrationDateTimeStr"></span>
    </div>



</div>

<script asp-location="Footer">

    $(function () {
        $("#DueDateStr").persianDatepicker();
        $("#KilometerRegistrationDateTimeStr").persianDatepicker();
    });

    $(document).ready(function () {
        ManucaturerIdHandler(@Model.CarBrandSpecificationAttributeOptionId);
        ModelSpecificationAttributeOptionIdHandler(@Model.ModelSpecificationAttributeOptionId);

        $("#TwoLeftNumberLicencePlate").on("keyup", function () {
            $("#TwoLeftNumberLicencePlate").val($("#TwoLeftNumberLicencePlate").val().substr(0, 2));
        });

        $("#ThreeRighNumberLicencePlate").on("keyup", function () {
            $("#ThreeRighNumberLicencePlate").val($("#ThreeRighNumberLicencePlate").val().substr(0, 3));
        });

        $("#IranNumberLicencePlate").on("keyup", function () {
            $("#IranNumberLicencePlate").val($("#IranNumberLicencePlate").val().substr(0, 2));
        });

    });

    $("#CarBrandSpecificationAttributeOptionId").on("change", function () {
        ManucaturerIdHandler($(this).val());
    });

    function ManucaturerIdHandler(carBrandSpecificationAttributeOptionId) {

        $("select#YearSpecificationAttributeOptionId").empty();
        $("select#YearSpecificationAttributeOptionId").prop("disabled", true);

        if (!carBrandSpecificationAttributeOptionId || carBrandSpecificationAttributeOptionId == 0) {

            $("select#ModelSpecificationAttributeOptionId").empty();
            $("select#ModelSpecificationAttributeOptionId").prop("disabled", true);
        }
        else {

            $.ajax({
                cache: false,
                type: "GET",
                url: `@Url.RouteUrl("CarGetModels")?specificationAttributeOptionId=${carBrandSpecificationAttributeOptionId}`,
                dataType: "json",
                success: function (data, textStatus, jqXHR) {

                    var text = `<option value="0">@T("NobParts.Plugin.Misc.CarInfo.Model.SelectDefaultOptionText")</option>`;
                    for (let i = 0; i < data.length; i++) {
                        if (data[i].Id != 0)
                            text += `<option value="${data[i].Id}" ${(data[i].Id == @(Model.ModelSpecificationAttributeOptionId) ? 'Selected="Selected"' : "")}>${data[i].Name}</option>`;
                    }

                    $("select#ModelSpecificationAttributeOptionId").html(text);
                    $("select#ModelSpecificationAttributeOptionId").prop("disabled", false);
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert('Failed to load');
                }
            });
        }
    }

    $("#ModelSpecificationAttributeOptionId").on("change", function () {
        ModelSpecificationAttributeOptionIdHandler($(this).val());
    });

    function ModelSpecificationAttributeOptionIdHandler(ModelSpecificationAttributeOptionId) {
        if (!ModelSpecificationAttributeOptionId || ModelSpecificationAttributeOptionId == 0) {
            $("select#YearSpecificationAttributeOptionId").empty();
            $("select#YearSpecificationAttributeOptionId").prop("disabled", true);
        }
        else {

            var carBrandSpecificationAttributeOptionId = $("#CarBrandSpecificationAttributeOptionId").val();

            $.ajax({
                cache: false,
                type: "GET",
                url: `@Url.RouteUrl("CarGetYears")?carBrandSpecificationAttributeOptionId=${carBrandSpecificationAttributeOptionId}`,
                dataType: "json",
                success: function (data, textStatus, jqXHR) {

                    var text = `<option value="0">@T("NobParts.Plugin.Misc.CarInfo.Year.SelectDefaultOptionText")</option>`;
                    for (let i = 0; i < data.length; i++) {
                        if (data[i].Id != 0)
                            text += `<option value="${data[i].Id}" ${(data[i].Id == @(Model.YearSpecificationAttributeOptionId ?? 0) ? 'Selected="Selected"' : "")}>${data[i].Name}</option>`;
                    }

                    $("select#YearSpecificationAttributeOptionId").html(text);
                    $("select#YearSpecificationAttributeOptionId").prop("disabled", false);
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert('Failed to load');
                }
            });
        }
    }
</script>
