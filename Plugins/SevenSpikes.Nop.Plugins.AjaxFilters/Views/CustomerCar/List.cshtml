@model CustomerCarSearchModel

@inject AdminAreaSettings adminAreaSettings
@inject INopFileProvider fileProvider;
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    Layout = "_ColumnsTwo";

    NopHtml.AddTitleParts(T("PageTitle.Account").Text);
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-address-list-page");

    NopHtml.SetActiveMenuItemSystemName(T("NobParts.Plugin.Widgets.ProductPriceInquiry.PriceInquiry.List.SystemName").Text);

    var culture = CultureInfo.CurrentCulture;
    var uiCulture = CultureInfo.CurrentUICulture;

    var kendoVersion = "2020.1.406";

    var defaultGridPageSize = adminAreaSettings.DefaultGridPageSize;
    var gridPageSizes = adminAreaSettings.GridPageSizes;

    //title
    NopHtml.AddTitleParts(T("NobParts.Plugin.Misc.CarInfo.Account.CustomerCars").Text);


    <link rel="stylesheet" href="~/Plugins/NobParts.Misc.CarInfo/Styles/kendoCommonStyles.css" />
    <link rel="stylesheet" href="~/Plugins/NobParts.Misc.CarInfo/Themes/DefaultClean/Content/CarInfo.css" />


    <link rel="stylesheet" href="~/Plugins/NobParts.Misc.CarInfo/Styles/kendoCommonStyles.rtl.css" />
    <link rel="stylesheet" href="~/Plugins/NobParts.Misc.CarInfo/Themes/DefaultClean/Content/CarInfo.rtl.css" />



    //<script src="~/lib/kendo/@kendoVersion/js/kendo.ui.core.min.js"></script>
    <script src="~/Plugins/NobParts.Misc.CarInfo/Scripts/lib/kendo/@kendoVersion/js/kendo.all.min.js" asp-location="Footer"></script>

    var fileInfo = fileProvider.GetFileInfo($"{WebHostEnvironment.WebRootPath}/lib/kendo/{kendoVersion}/js/messages/kendo.messages.{uiCulture.Name}.min.js");

    <script asp-exclude-from-bundle="true" src="~/lib/kendo/@kendoVersion/js/messages/kendo.messages.@(fileInfo.Exists ? uiCulture.Name : NopCommonDefaults.DefaultLanguageCulture).min.js"></script>


    <script src="~/lib/kendo/@kendoVersion/js/cultures/kendo.culture.@(culture.Name).min.js"></script>

}

@section left
{
    @await Component.InvokeAsync(typeof(CustomerNavigationViewComponent), new { selectedTabId = /*CustomerNavigationEnum.Addresses*/150 })
}

<script asp-location="Footer">
    kendo.culture("@(culture.Name)");
</script>

<nop-antiforgery-token />

<div class="page account-page car-info-page my-cars-page">
    <div class="page-title">
        <h1 class="pt-text">@T("NobParts.Plugin.Misc.CarInfo.Account.CustomerCars")</h1>
    </div>
    <div class="page-body">

        <div id="grid-filters" class="grid-filters">
        </div>
        <div class="add-button">
            <button type="button" class="button-1 add-address-button" onclick="location.href='@Url.RouteUrl("CustomerCarAdd")'">@T("Common.AddNew")</button>
        </div>

        <div id="customer-cars-grid" class="tickets-table-panel"></div>

    </div>
</div>

<script>
    $(document).ready(function () {
        $("#customer-cars-grid").kendoGrid({
            dataSource: {
                type: "json",
                transport: {
                    read: {
                        url: "@Html.Raw(Url.Action("List", "CustomerCar"))",
                        type: "POST",
                        dataType: "json",
                        data: function () {
                            var data = {
                            };
                            addAntiForgeryToken(data);
                            return data;
                        }
                    }
                },
                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors"
                },
                error: function (e) {
                    display_kendoui_grid_error(e);
                    // Cancel the changes
                    this.cancelChanges();
                },
                pageSize: @defaultGridPageSize,
                serverPaging: true,
                serverFiltering: true,
                serverSorting: true
            },
            pageable: {
                refresh: true,
                pageSizes: [@(gridPageSizes)],
                messages: {
                    refresh: "@T("NobParts.Plugin.Widgets.ProductPriceInquiry.Pager.Messages.Refresh")",
                    itemsPerPage: "@T("NobParts.Plugin.Widgets.ProductPriceInquiry.Pager.Messages.ItemsPerPage")",
                    empty: "@T("NobParts.Plugin.Widgets.ProductPriceInquiry.Pager.Messages.Empty")"
                }
            },
            editable: {
                confirmation: "@T("Admin.Common.DeleteConfirmation")",
                mode: "inline"
            },
            scrollable: false,
            columns: [
                {
                    field: "CarBrandSpecificationAttributeOptionName",
                    title: "@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.CarBrandSpecificationAttributeOptionId")",
                    width: 100
                },
                {
                    field: "ModelSpecificationAttributeOptionName",
                    title: "@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.ModelSpecificationAttributeOptionId")",
                    width: 100
                },
                {
                    field: "YearSpecificationAttributeOptionName",
                    title: "@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.YearSpecificationAttributeOptionId")",
                    width: 100
                },
                {
                    field: "LicencePlate",
                    title: "@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.LicencePlate")",
                    width: 100
                },
                {
                    field: "ThirdPartyInsurancePolicyNumber",
                    title: "@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.ThirdPartyInsurancePolicyNumber")",
                    width: 100
                },
                {
                    field: "KilometerRegistrationDateTimeStr",
                    title: "@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.KilometerRegistrationDateTimeStr")",
                    width: 100

                },
                {
                    field: "BodyInsurancePolicyNumber",
                    title: "@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.BodyInsurancePolicyNumber")",
                    width: 100

                },
                // {
                //     field: "BodyInsurancePolicyExpirationDateStr",
                //     title: "@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.BodyInsurancePolicyExpirationDate")",
                // },
                {
                    field: "VinNumber",
                    title: "@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.VinNumber")",
                    width: 100

                },
                // {
                //     field: "TechnicalVisitExpirationDateStr",
                //     title: "@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.TechnicalVisitExpirationDate")",
                // },
                {
                    field: "Id",
                    title: "@T("NobParts.Plugin.Misc.CarInfo.CustomerCarModel.Manage")",
                    template: '<button class="k-button k-grid-edit" onclick="editCustomerCar(#=Id#)">@T("Common.Edit")</button>',
                    locked: true,
                    width:100
                },
            ]
        });
    });

    function editCustomerCar(id) {
        // Redirect to the edit page or open a modal for editing
        window.location.href = '/customer/caredit/' + id;
    }

    $($('#customer-cars-grid').data('kendoGrid').table).css('table-layout', 'fixed');

    $('#customer-cars-grid').data('kendoGrid').wrapper.find('.k-pager-sizes select').data('kendoDropDownList').one("open", function (e) {
        setTimeout(function () {
            e.sender.popup.wrapper.addClass("dropdown-wrapper");
        });
    }).list.addClass("grid-totalPages-list");
</script>

<script>
    $(document).ready(function () {
        //search button
        $('#search-categories').click(function () {
            //search
            var grid = $('#customer-cars-grid').data('kendoGrid');
            grid.dataSource.page(1); //new search. Set page size to 1
            //grid.dataSource.read(); we already loaded the grid above using "page" function
            return false;
        });

    });

    function addAntiForgeryToken(data) {
        //if the object is undefined, create a new one.
        if (!data) {
            data = {};
        }
        //add token
        var tokenInput = $('input[name=__RequestVerificationToken]');
        if (tokenInput.length) {
            data.__RequestVerificationToken = tokenInput.val();
        }
        return data;
    };

</script>