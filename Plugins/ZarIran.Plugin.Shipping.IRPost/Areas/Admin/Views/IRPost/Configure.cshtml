@model ZarIran.Plugin.Shipping.IRPost.Areas.Admin.Models.ConfigurationModel

@{
	Layout = "_ConfigurePlugin";
	NopHtml.SetActiveMenuItemSystemName(T("ZarIran.Plugin.Shipping.IRPost.Configuration.SystemName").Text);
}

<form asp-controller="IRPost" asp-action="Configure" method="post">
	<section class="content">
		<div class="container-fluid">
			<div class="cards-group">
				<div class="card card-default">
					<div class="card-body">

						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="User" />
							</div>
							<div class="col-md-9">
								<nop-editor asp-for="User" asp-required="true" />
								<span asp-validation-for="User"></span>
							</div>
						</div>

						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="Password" />
							</div>
							<div class="col-md-9">
								<nop-editor asp-for="Password" asp-required="true" />
								<span asp-validation-for="Password"></span>
							</div>
						</div>

						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="BaseUrl" />
							</div>
							<div class="col-md-9">
								<nop-editor asp-for="BaseUrl" asp-required="true" />
								<span asp-validation-for="BaseUrl"></span>
							</div>
						</div>

						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="ContractCode" />
							</div>
							<div class="col-md-9">
								<nop-editor asp-for="ContractCode" asp-required="true" />
								<span asp-validation-for="ContractCode"></span>
							</div>
						</div>

						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="PostNodeCode" />
							</div>
							<div class="col-md-9">
								<nop-editor asp-for="PostNodeCode" asp-required="true" />
								<span asp-validation-for="PostNodeCode"></span>
							</div>
						</div>

						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="ShippingMethodId" />
							</div>
							<div class="col-md-9">
								<nop-select asp-for="ShippingMethodId" asp-items="Model.AvailableShippingMethods" />
								<span asp-validation-for="ShippingMethodId"></span>
							</div>
						</div>

						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="EnableManualCalc" asp-required="true" />
							</div>
							<div class="col-md-9">
								<nop-editor asp-for="EnableManualCalc" />
								<span asp-validation-for="EnableManualCalc"></span>
							</div>
						</div>


						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="NeighbouringProvinces" />
							</div>
							<div class="col-md-9">
								<div class="input-group-append input-group-required">
									<div class="input-group">
										<nop-select asp-for="NeighbouringProvinces" asp-items="Model.AvailableNeighbouringProvinces" asp-multiple="true" />
									</div>
									<div class="input-group-btn">
										<nop-required />
									</div>
								</div>
								<span asp-validation-for="NeighbouringProvinces"></span>
							</div>
						</div>

