@model ZarIran.Plugin.Misc.GoldPurchase.Models.ConfigurationModel
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "تنظیمات خرید طلا";
}
<form asp-controller="GoldPurchase" asp-action="Configure" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">تنظیمات خرید طلا</h1>
        <div class="float-right">
            <button type="submit" class="btn btn-primary">ذخیره</button>
        </div>
    </div>
    <div asp-validation-summary="All"></div>

    <div class="card card-default">
        <div class="card-body">
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="GoldProductId" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="GoldProductId" />
                    <span asp-validation-for="GoldProductId"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="DefaultAmount" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="DefaultAmount" />
                    <span asp-validation-for="DefaultAmount"></span>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="MinimumAmount" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="MinimumAmount" />
                    <span asp-validation-for="MinimumAmount"></span>
                </div>
            </div>


            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="MaximumAmount" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="MaximumAmount" />
                    <span asp-validation-for="MaximumAmount"></span>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="PaymentSystemName" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="PaymentSystemName" />
                    <span asp-validation-for="PaymentSystemName"></span>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="IsActive" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="IsActive" />
                    <span asp-validation-for="IsActive"></span>
                </div>
            </div>

             <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="BuyCommission" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="BuyCommission" />
                    <span asp-validation-for="BuyCommission"></span>
                    <small class="form-text text-muted">درصد افزوده‌شده به نرخ بازار هر گرم؛ مبلغ واردشده مشتری شامل این کارمزد است. صفر یعنی بدون کارمزد خرید.</small>
                </div>
            </div>

             <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="SellCommission" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="SellCommission" />
                    <span asp-validation-for="SellCommission"></span>
                    <small class="form-text text-muted">درصد کارمزد فروش؛ مشتری هر گرم را به «قیمت بازار منهای این درصد» می‌فروشد.</small>
                </div>
            </div>
        </div>
    </div>
</form>
