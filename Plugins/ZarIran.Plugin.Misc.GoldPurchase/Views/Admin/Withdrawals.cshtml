@model Nop.Core.IPagedList<ZarIran.Plugin.Misc.GoldPurchase.Domain.GoldWithdrawal>
@inject Nop.Services.Helpers.IDateTimeHelper DateTimeHelper
@using System
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "درخواست برداشت وجه";
    var completed = (bool)ViewBag.Completed;
}
<div class="content-header clearfix">
    <h1 class="float-left">درخواست برداشت وجه</h1>
</div>
<section class="content">
    <div class="container-fluid">
        <div class="card card-default">
            <div class="card-header">
                <nav class="nav nav-tabs" aria-label="وضعیت درخواست برداشت">
                    <a class="nav-link @(!completed ? "active" : "")" aria-current="@(!completed ? "page" : null)"
                       asp-action="List" asp-route-completed="false">باز</a>
                    <a class="nav-link @(completed ? "active" : "")" aria-current="@(completed ? "page" : null)"
                       asp-action="List" asp-route-completed="true">انجام‌شده</a>
                </nav>
            </div>
            <div class="card-body">
                @if (Model.Count == 0)
                {
                    <p class="text-muted">درخواستی در این وضعیت ثبت نشده است.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead><tr><th>درخواست</th><th>مشتری</th><th>مبلغ (تومان)</th><th>زمان ثبت</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td>@request.Id</td>
                                    <td>@request.CustomerName (@request.CustomerId)</td>
                                    <td>@request.Amount.ToString("N0")</td>
                                    <td>@((await DateTimeHelper.ConvertToUserTimeAsync(request.CreatedOnUtc, DateTimeKind.Utc)).ToString("yyyy-MM-dd HH:mm"))</td>
                                    <td><a class="btn btn-default btn-sm" asp-action="Details" asp-route-id="@request.Id">مشاهده جزئیات</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <nav aria-label="صفحه درخواست‌ها">
                        @if (Model.HasPreviousPage)
                        {
                            <a class="btn btn-default" asp-action="List" asp-route-completed="@completed" asp-route-page="@Model.PageIndex">قبلی</a>
                        }
                        @if (Model.HasNextPage)
                        {
                            <a class="btn btn-default" asp-action="List" asp-route-completed="@completed" asp-route-page="@(Model.PageIndex + 2)">بعدی</a>
                        }
                    </nav>
                }
            </div>
        </div>
    </div>
</section>
