@model ZarIran.Plugin.Misc.GoldPurchase.Models.CustomerGoldWalletModel
@using System.Globalization

@{
    var inv = CultureInfo.InvariantCulture;
}

<nop-card asp-name="customer-goldwallet"
          asp-icon="fas fa-coins"
          asp-title="کیف پول طلا"
          asp-hide-block-attribute-name="CustomerPage.HideGoldWalletBlock"
          asp-hide="false"
          asp-advanced="false">
    <div class="card-body">

        <div class="form-group row">
            <div class="col-md-3"><strong>موجودی فعلی</strong></div>
            <div class="col-md-9">
                <strong style="font-size:1.4em;">@Model.BalanceGrams.ToString("0.########", inv) گرم</strong>
            </div>
        </div>

        @if (Model.Rows.Count == 0)
        {
            <p class="text-muted">هنوز تراکنشی برای این مشتری ثبت نشده است.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>تاریخ</th>
                            <th>نوع</th>
                            <th>تغییر (گرم)</th>
                            <th>موجودی پس از تراکنش (گرم)</th>
                            <th>قیمت هر گرم (تومان)</th>
                            <th>مبلغ (تومان)</th>
                            <th>سفارش</th>
                            <th>مدیر ثبت‌کننده</th>
                            <th>توضیحات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>@row.CreatedOn</td>
                                <td>@row.Type</td>
                                <td dir="ltr" class="@(row.Grams >= 0 ? "text-success" : "text-danger")">
                                    @(row.Grams > 0 ? "+" : "")@row.Grams.ToString("0.########", inv)
                                </td>
                                <td dir="ltr">@row.BalanceAfterGrams.ToString("0.########", inv)</td>
                                <td>@(row.PricePerGram > 0 ? row.PricePerGram.ToString("N0", inv) : "—")</td>
                                <td>@(row.Amount > 0 ? row.Amount.ToString("N0", inv) : "—")</td>
                                <td>
                                    @if (row.OrderId.HasValue)
                                    {
                                        <a href="@Url.Action("Edit", "Order", new { id = row.OrderId.Value, area = "Admin" })">#@row.OrderId.Value</a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>@if (row.AdminCustomerId.HasValue) { <a href="@Url.Action("Edit", "Customer", new { area = "Admin", id = row.AdminCustomerId.Value })">#@row.AdminCustomerId</a> } else { <span>—</span> }</td>
                                <td>@row.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between">
            @if (Model.HistoryPage > 1) { <a href="@Url.Action("Details", "GoldWalletAdmin", new { area = "Admin", customerId = Model.CustomerId, page = Model.HistoryPage - 1 })">صفحه قبل</a> }
            <span>صفحه @Model.HistoryPage از @Math.Max(1, Model.HistoryPages)</span>
            @if (Model.HistoryPage < Model.HistoryPages) { <a href="@Url.Action("Details", "GoldWalletAdmin", new { area = "Admin", customerId = Model.CustomerId, page = Model.HistoryPage + 1 })">صفحه بعد</a> }
            </div>
        }

        <div class="card card-default no-margin">
            <div class="card-header">افزایش / کاهش موجودی طلا</div>
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3"><label for="gold-adjust-grams">مقدار (گرم)</label></div>
                    <div class="col-md-9">
                        <input type="text" id="gold-adjust-grams" class="form-control" dir="ltr"
                               placeholder="مثلاً 0.5 برای افزایش یا -0.25 برای کاهش" autocomplete="off" />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><label for="gold-adjust-note">توضیحات</label></div>
                    <div class="col-md-9">
                        <input type="text" id="gold-adjust-note" class="form-control" maxlength="1000"
                               placeholder="دلیل تغییر (برای سوابق)" autocomplete="off" />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="button" id="gold-adjust-button" class="btn btn-primary">ثبت تغییر</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            $(document).ready(function () {
                $('#gold-adjust-button').click(function () {
                    var grams = $('#gold-adjust-grams').val();
                    if (!$('#gold-adjust-note').val().trim()) { alert('دلیل تغییر موجودی را وارد کنید.'); return; }
                    if (!grams) {
                        alert('مقدار طلا را وارد کنید.');
                        return;
                    }
                    if (!confirm('موجودی طلای مشتری ' + grams + ' گرم تغییر کند؟')) {
                        return;
                    }

                    var button = $('#gold-adjust-button');
                    button.attr('disabled', true);

                    var postData = {
                        customerId: '@Model.CustomerId',
                        grams: grams,
                        note: $('#gold-adjust-note').val()
                    };
                    addAntiForgeryToken(postData);

                    $.ajax({
                        cache: false,
                        type: 'POST',
                        url: '@Url.Action("Adjust", "GoldWalletAdmin", new { area = "Admin" })',
                        data: postData,
                        success: function (data) {
                            if (data.Result) {
                                // simplest reliable refresh of balance + history table
                                location.reload();
                            } else {
                                display_nop_error(data);
                            }
                        },
                        error: function () { alert('ثبت تغییر انجام نشد. سابقه را بررسی کنید و دوباره تلاش کنید.'); },
                        complete: function () {
                            button.attr('disabled', false);
                        }
                    });
                });
            });
        </script>
    </div>
</nop-card>
