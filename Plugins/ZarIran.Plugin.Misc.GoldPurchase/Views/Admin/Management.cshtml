@model ZarIran.Plugin.Misc.GoldPurchase.Models.GoldManagementModel
@{ Layout = "_AdminLayout"; ViewBag.PageTitle = "مدیریت موجودی طلای کاربران"; }
<div class="content-header clearfix"><h1 class="float-left">مدیریت موجودی طلای کاربران</h1></div>
<section class="content"><div class="container-fluid"><div class="card card-default"><div class="card-body">
    <form method="get" asp-controller="GoldWalletAdmin" asp-action="List" asp-area="Admin">
        <div class="row"><div class="col-md-4"><label for="gold-email">ایمیل</label><input id="gold-email" class="form-control" name="email" value="@Model.Email" /></div>
        <div class="col-md-4"><label for="gold-first-name">نام</label><input id="gold-first-name" class="form-control" name="firstName" value="@Model.FirstName" /></div>
        <div class="col-md-4 align-self-end"><button class="btn btn-primary" type="submit">جست‌وجو</button></div></div>
    </form>
</div></div><div class="card card-default"><div class="card-body"><div class="table-responsive">
<table class="table table-bordered table-hover"><thead><tr><th>شناسه</th><th>نام مشتری</th><th>ایمیل</th><th>موجودی طلا (گرم)</th><th>مدیریت</th></tr></thead><tbody>
@foreach (var customer in Model.Customers) {
<tr><td>@customer.Id</td><td>@customer.Name</td><td>@customer.Email</td><td dir="ltr">@customer.Balance.ToString("0.########")</td><td><a class="btn btn-default" href="@Url.Action("Details", "GoldWalletAdmin", new { area = "Admin", customerId = customer.Id })">تراکنش‌ها و تغییر موجودی</a></td></tr>
}
@if (!Model.Customers.Any()) { <tr><td colspan="5">کاربری یافت نشد.</td></tr> }
</tbody></table></div>
<div class="d-flex justify-content-between">
@if (Model.Page > 1) { <a href="@Url.Action("List", new { page = Model.Page - 1, email = Model.Email, firstName = Model.FirstName })">صفحه قبل</a> }
<span>صفحه @Model.Page از @Math.Max(1, Model.TotalPages)</span>
@if (Model.Page < Model.TotalPages) { <a href="@Url.Action("List", new { page = Model.Page + 1, email = Model.Email, firstName = Model.FirstName })">صفحه بعد</a> }
</div></div></div></div></section>
