@model ZarIran.Plugin.Misc.GoldPurchase.Domain.GoldWithdrawal
@inject Nop.Services.Helpers.IDateTimeHelper DateTimeHelper
@using System
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "جزئیات درخواست برداشت وجه";
    var completed = Model.CompletedOnUtc.HasValue;
}
<div class="content-header clearfix">
    <h1 class="float-left">درخواست برداشت #@Model.Id</h1>
    <div class="float-right">
        <a class="btn btn-default" asp-action="List" asp-route-completed="@completed">بازگشت به درخواست‌ها</a>
    </div>
</div>
<section class="content">
    <div class="container-fluid">
        <div class="card card-default">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">وضعیت</dt><dd class="col-sm-8">@(completed ? "انجام‌شده" : "باز")</dd>
                    <dt class="col-sm-4">مبلغ برداشت از اعتبار فروش طلا</dt><dd class="col-sm-8">@Model.Amount.ToString("N0") تومان</dd>
                    <dt class="col-sm-4">شناسه مشتری</dt><dd class="col-sm-8">@Model.CustomerId</dd>
                    <dt class="col-sm-4">نام و نام خانوادگی</dt><dd class="col-sm-8">@Model.CustomerName</dd>
                    <dt class="col-sm-4">شماره تماس</dt><dd class="col-sm-8"><bdi>@Model.Phone</bdi></dd>
                    <dt class="col-sm-4">شماره شبا</dt><dd class="col-sm-8"><bdi dir="ltr">@Model.Sheba</bdi></dd>
                    <dt class="col-sm-4">زمان ثبت</dt><dd class="col-sm-8">@((await DateTimeHelper.ConvertToUserTimeAsync(Model.CreatedOnUtc, DateTimeKind.Utc)).ToString("yyyy-MM-dd HH:mm"))</dd>
                    @if (completed)
                    {
                        <dt class="col-sm-4">زمان انجام</dt><dd class="col-sm-8">@((await DateTimeHelper.ConvertToUserTimeAsync(Model.CompletedOnUtc.Value, DateTimeKind.Utc)).ToString("yyyy-MM-dd HH:mm"))</dd>
                        <dt class="col-sm-4">شناسه مدیر ثبت‌کننده</dt><dd class="col-sm-8">@Model.CompletedByCustomerId</dd>
                    }
                </dl>
                @if (!completed)
                {
                    <form asp-action="Complete" asp-route-id="@Model.Id" method="post">
                        <div class="form-check mb-3">
                            <input type="checkbox" class="form-check-input" id="gold-payout-paid" name="paid" value="true" required />
                            <label class="form-check-label" for="gold-payout-paid">مبلغ به شماره شبای ثبت‌شده واریز شده است.</label>
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-check" aria-hidden="true"></i> ثبت انجام برداشت</button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
