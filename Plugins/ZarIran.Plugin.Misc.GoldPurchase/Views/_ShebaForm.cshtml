@model bool
<form asp-controller="GoldWithdrawal" asp-action="AddSheba" asp-area="" method="post">
    <input type="hidden" name="fromSell" value="@Model.ToString().ToLowerInvariant()" />
    <div class="gold-field">
        <label for="gold-sheba-number">شماره شبای جدید</label>
        <input id="gold-sheba-number" name="number" dir="ltr" type="text" inputmode="text"
               placeholder="IR" maxlength="50" autocomplete="off" required />
        <small>شماره شبا باید متعلق به حساب بانکی خودتان باشد.</small>
    </div>
    <button class="button-1 gold-submit" type="submit">ذخیره شماره شبا</button>
</form>
