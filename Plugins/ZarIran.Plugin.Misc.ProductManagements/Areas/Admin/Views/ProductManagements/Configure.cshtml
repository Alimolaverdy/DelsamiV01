@model ZarIran.Plugin.Misc.ProductManagements.Areas.Admin.Models.Configurations.ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
    NopHtml.SetActiveMenuItemSystemName("ExtendedVendorConfiguration");
}

<form asp-controller="ProductManagement" asp-action="Configure" method="post">
    <section class="content">
        <div class="container-fluid">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="GroupedProductOrderBy" />
                            </div>
                            <div class="col-md-9">
                                <nop-select asp-for="GroupedProductOrderBy" asp-items="@await (((GroupedProductOrderBy)Model.GroupedProductOrderBy).ToSelectListAsync())" />
                                <span asp-validation-for="GroupedProductOrderBy"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="SortType" />
                            </div>
                            <div class="col-md-9">
                                <nop-select asp-for="SortType" asp-items="@await (((SortType)Model.SortType).ToSelectListAsync())" />
                                <span asp-validation-for="SortType"></span>
                            </div>
                        </div>

                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="SortType" />
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="SortType" asp-items="@await (((SortType)Model.SortType).ToSelectListAsync())" />
                            <span asp-validation-for="SortType"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="BestSellerCount" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="BestSellerCount" asp-required="true" />
                            <span asp-validation-for="BestSellerCount"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="BackInStockSubscriptionExpireInDays" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="BackInStockSubscriptionExpireInDays" asp-required="true" />
                            <span asp-validation-for="BackInStockSubscriptionExpireInDays"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="BackInStockSubscriptionActivePeriodInDays" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="BackInStockSubscriptionActivePeriodInDays" asp-required="true" />
                            <span asp-validation-for="BackInStockSubscriptionActivePeriodInDays"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="MaxBackInStockSubsPerCustomer" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="MaxBackInStockSubsPerCustomer" asp-required="true" />
                            <span asp-validation-for="MaxBackInStockSubsPerCustomer"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="MaxBackInStockSubsPerCustomerAndProduct" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="MaxBackInStockSubsPerCustomerAndProduct" asp-required="true" />
                            <span asp-validation-for="MaxBackInStockSubsPerCustomerAndProduct"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
</form>