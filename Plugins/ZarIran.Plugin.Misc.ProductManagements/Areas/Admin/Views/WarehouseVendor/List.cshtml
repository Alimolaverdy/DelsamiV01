@model WarehouseVendorSearchModel

@using Nop.Core.Domain.Common
@{
    Layout = "_AdminLayout";
    //page title
    ViewBag.PageTitle = T("ZarIran.Plugin.Misc.ExtendedVendor.Warehousevendor.List").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("ZarIran.Plugin.Misc.ExtendedVendor.Warehousevendor.List.SystemName");
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("ZarIran.Plugin.Misc.ExtendedVendor.Warehousevendor.List")
    </h1>
    <div class="float-right">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-square"></i>
            @T("Admin.Common.AddNew")
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
    <div class="form-horizontal">
        <div class="cards-group">
            <div class="card card-default">
                <div class="card-body">

                    @await Html.PartialAsync("Table", new DataTablesModel
                    {
                        Name = "warehouse-vendors-grid",
                        UrlRead = new DataUrl("List", "WarehouseVendor", null),
                        SearchButtonId = "search-warehouse-vendors",
                        Length = Model.PageSize,
                        LengthMenu = Model.AvailablePageSizes,
                        Filters = new List<FilterParameter>
                        {
                        },
                        ColumnCollection = new List<ColumnProperty>
                        {
                            new ColumnProperty(nameof(WarehouseVendorModel.WarehouseName))
                            {
                        Title = T("ZarIran.Plugin.Misc.ExtendedVendor.WarehouseVendorModel.WarehouseName").Text,
                                Width = "300"
                            },
                            new ColumnProperty(nameof(WarehouseVendorModel.VendorName))
                            {
                        Title = T("ZarIran.Plugin.Misc.ExtendedVendor.WarehouseVendorModel.VendorName").Text,
                                Width = "300"
                            },
                            new ColumnProperty(nameof(WarehouseVendorModel.Id))
                            {
                                Title = T("Admin.Common.Edit").Text,
                                Width = "50",
                                ClassName =  NopColumnClassDefaults.Button,
                                Render = new RenderButtonEdit(new DataUrl("Edit"))
                            }
                        }
                    })
                </div>
            </div>
        </div>
    </div>
</div>
</section>