@model VirtualProductPreviewModel

<div id="previewVirtualProductForm">
    <input type="hidden" asp-for="MainProductId" />
<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th class="text-center" width="70">@T("Admin.Catalog.Products.VirtualProducts.Preview.Selected")</th>
            <th>@T("Admin.Catalog.Products.VirtualProducts.Preview.Name")</th>
            <th>@T("Admin.Catalog.Products.VirtualProducts.Preview.Description")</th>
            <th class="text-center" width="70">@T("Admin.Catalog.Products.VirtualProducts.Preview.Status")</th>
        </tr>
    </thead>
    <tbody>
        
@for (int i = 0; i < Model.Items.Count; i++)
{
    <tr>
        <td class="text-center">
            <input asp-for="Items[i].Selected"
                   disabled="@(!Model.Items[i].CanSelect)" />

            <input asp-for="Items[i].Name" type="hidden" />
            <input asp-for="Items[i].Description" type="hidden" />
            <input asp-for="Items[i].CanSelect" type="hidden" />
        </td>

        <td>
            @Model.Items[i].Name
        </td>

        <td>
            @Model.Items[i].Description
        </td>

        <td class="text-center">
            @(Model.Items[i].CanSelect ? "✅" : "❌")
        </td>
    </tr>
}

    </tbody>
</table> 

 <button type="button" name="save" class="btn btn-primary mt-1" id="preview-Submit">
     <i class="far fa-save"></i>
     @T("Admin.Common.Save")
 </button>
 </div>