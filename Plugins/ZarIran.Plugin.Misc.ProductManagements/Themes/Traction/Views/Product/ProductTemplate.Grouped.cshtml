                                    @await Html.PartialAsync("_AddToWishlist", variant.AddToCart, dataDictAddToWishlist)
                                    } *@
                                        </div>
                                    </div>
                                }
                            }

                            @if (Model.AssociatedProducts.Count == 0)
                            {
                                <div class="product-variant-line">
                                    <div class="product-variant-line-title">
                                        @T("products.vendor")
                                    </div>

                                    <div class="additional-details d-flex justify-content-between align-items-center">
                                        <div class="product-vendor">
                                            <span class="label">@T("Products.Vendor"):</span>
                                            <span class="value">
                                                <h4>@T("vendors.ZarIran")</h4>
                                            </span>
                                        </div>
                                        <div class="no-associated-products">
                                            @T("Products.NoAssociatedProducts")
                                        </div>
                                    </div>


                                    <div class="additional-details-badges">
                                        <span>
                                            @T("Shippment-2hours-tehran")
                                        </span>
                                        <span>
                                            @T("Shippment-fast-everywhere")
                                        </span>
                                        <span>
                                            @T("product-warranty")
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </form>

    @await Html.PartialAsync("~/Themes/Traction/Views/Product/_FullProductDescription.cshtml", Model)

    @*we do not display "also purchased" for grouped products
    @await Component.InvokeAsync(typeof(ProductsAlsoPurchasedViewComponent), new { productId = Model.Id })*@
    @await Component.InvokeAsync(typeof(RelatedProductsViewComponent), new { productId = Model.Id })
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsBottom, additionalData = Model })

</div>

<script asp-location="Head" type="application/ld+json">
       {
      "@@context": "https://schema.org/",
      "@@type": "Product",
      "name": "@Html.Raw(HttpUtility.HtmlDecode(Model.Name))",
      "image": [
    @Html.Raw(HttpUtility.HtmlDecode(pictureUrlsForSchema))
      ],
      "description": "@Html.Raw(HttpUtility.HtmlDecode(HttpUtility.JavaScriptStringEncode(fullDescriptionForSchema)))",
      "brand": [
    @Html.Raw(HttpUtility.HtmlDecode(manufacturersForSchema))
      ],
      "offers": [

    @foreach (var variant in customVariants)
    {
                            int i = 0;
                            <Text>
                                                                              {
                                                                                "@@type": "Offer",
                                                                                "url": "@currentUrl",
                                                                                "priceCurrency": "IRR",
                                                                                "price": "@((variant.ProductPrice.PriceValue * 10).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))",
                                                                                "availability":"@(variant.InStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock")",
                                                                                "itemCondition": "https://schema.org/NewCondition",
                                                                                "seller": {
                                                                                  "@@type": "Organization",
                                                                                  "name": "@Html.Raw(HttpUtility.HtmlDecode(variant.VendorModel.Name))"
                                                                                }
                                                                               }
                            </Text>

                            if (i != customVariants.Count() - 1)
                            {
                                                    <Text>,</Text>
                            }
    }
      ]
    }
</script>

