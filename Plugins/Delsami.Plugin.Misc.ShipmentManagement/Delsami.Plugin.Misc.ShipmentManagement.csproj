<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<Company>Delsami</Company>
		<Authors>Delsami</Authors>
		<PackageProjectUrl>PACKAGE_PROJECT_URL</PackageProjectUrl>
		<RepositoryUrl>REPOSITORY_URL</RepositoryUrl>
		<RepositoryType>Git</RepositoryType>
		<OutputPath>..\..\Presentation\Nop.Web\Plugins\Delsami.Misc.ShipmentManagement</OutputPath>
		<OutDir>$(OutputPath)</OutDir>
		<!--Set this parameter to true to get the dlls copied from the NuGet cache to the output of your    project. You need to set this parameter to true if your plugin has a nuget package to ensure that   the dlls copied from the NuGet cache to the output of your project-->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>


	<ItemGroup>
		<None Remove="Areas\Admin\Views\_ViewImports.cshtml" />
		<None Remove="plugin.json" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Areas\Admin\Views\_ViewImports.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="plugin.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ClearPluginAssemblies Include="$(MSBuildProjectDirectory)\..\..\Build\ClearPluginAssemblies.proj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Areas\Admin\Views\Order\_OrderDetails.BillingShipping.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Areas\Admin\Views\ShipmentManagement\Configure.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Areas\Admin\Views\ShipmentTrackingNumberImport\Import.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Areas\Admin\Views\ShipmentTrackingNumberImport\ImportList.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Areas\Admin\Views\ShipmentTrackingNumberImport\Report.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Themes\Traction\Views\DelsamiShipmentManagement\CustomerOrders.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="Themes\Traction\Views\DelsamiShipmentManagement\OrderDetails.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="Themes\Traction\Views\_ViewImports.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Areas\Admin\Views\Order\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="EPPlus" Version="6.2.10" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning" Version="5.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Presentation\Nop.Web\Nop.Web.csproj">
			<Private>False</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Delsami.Plugin.Misc.Core">
		  <HintPath>..\..\Presentation\Nop.Web\Plugins\Delsami.Misc.Core\Delsami.Plugin.Misc.Core.dll</HintPath>
		  <Private>False</Private>
		</Reference>
		<Reference Include="Delsami.Plugin.Misc.SMS">
			<HintPath>..\..\Presentation\Nop.Web\Plugins\Delsami.Misc.SMS\Delsami.Plugin.Misc.SMS.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Delsami.Plugin.OrderFulfillment.DeliveryScheduling">
		  <HintPath>..\..\Presentation\Nop.Web\Plugins\Delsami.OrderFulfillment.DeliveryScheduling\Delsami.Plugin.OrderFulfillment.DeliveryScheduling.dll</HintPath>
		  <Private>False</Private>
		</Reference>
		<Reference Include="Delsami.Plugin.Payment.Core">
			<HintPath>..\..\Presentation\Nop.Web\Plugins\Delsami.Payment.Core\Delsami.Plugin.Payment.Core.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<!-- This target execute after "Build" target -->
	<Target Name="NopTarget" AfterTargets="Build">
		<!-- Delete unnecessary libraries from plugins path -->
		<MSBuild Projects="@(ClearPluginAssemblies)" Properties="PluginPath=$(MSBuildProjectDirectory)\$(OutDir)" Targets="NopClear" />
	</Target>

</Project>
