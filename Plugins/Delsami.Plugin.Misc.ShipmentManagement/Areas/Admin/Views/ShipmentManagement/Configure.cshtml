@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
    NopHtml.SetActiveMenuItemSystemName(T("ZarIran.Plugin.Misc.ShipmentManagement.Configuration.SystemName").Text);
}

<form asp-controller="ShipmentManagement" asp-action="Configure" method="post">
    <section class="content">
        <div class="container-fluid">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="DeliveryCodeToCustomerEnabled" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="DeliveryCodeToCustomerEnabled" asp-required="true" />
                                <span asp-validation-for="DeliveryCodeToCustomerEnabled"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="DeliveryCodeToCustomerMessageTemplate" />
                            </div>
                            <div class="col-md-9">
                                <nop-textarea asp-for="DeliveryCodeToCustomerMessageTemplate" asp-required="true" />
                                <span asp-validation-for="DeliveryCodeToCustomerMessageTemplate"></span>
                            </div>
                        </div>


                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="DeliverdToCustomerEnabled" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="DeliverdToCustomerEnabled" asp-required="true" />
                                <span asp-validation-for="DeliverdToCustomerEnabled"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="DeliverdToCustomerMessageTemplate" />
                            </div>
                            <div class="col-md-9">
                                <nop-textarea asp-for="DeliverdToCustomerMessageTemplate" asp-required="true" />
                                <span asp-validation-for="DeliverdToCustomerMessageTemplate"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="ShipmentIdIndicatorWordInFile" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="ShipmentIdIndicatorWordInFile" asp-required="true" />
                                <span asp-validation-for="ShipmentIdIndicatorWordInFile"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="TrackingNumberIndicatorWordInFile" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="TrackingNumberIndicatorWordInFile" asp-required="true" />
                                <span asp-validation-for="TrackingNumberIndicatorWordInFile"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="IRPostTrackingLink" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="IRPostTrackingLink" asp-required="true" />
                                <span asp-validation-for="IRPostTrackingLink"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="TipaxTrackingLink" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="TipaxTrackingLink" asp-required="true" />
                                <span asp-validation-for="TipaxTrackingLink"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3"></div>
                            <div class="col-md-9">
                                <span> لینک نمونه: https://tracking.post.ir/?id={id}</span>
                            </div>
                        </div>


                        <div class="form-group row">
                            <div class="col-md-9 offset-md-3">
                                <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>
</form>