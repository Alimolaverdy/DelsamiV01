@inject ShipmentManagementSettings _shipmentSettings
@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName(T("ZarIran.Plugin.Misc.ShipmentManagement.ShipmentTrackingNumberImport.Import").Text);

}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Admin.Orders.Shipments.ImportShipmentTrackNumber.ImportFile")
    </h1>
</div>

<div class="content">

    <div class="card card-default">
        <div class="card-body">

            <form asp-controller="ShipmentTrackingNumberImport"
                  asp-action="Import"
                  method="post"
                  enctype="multipart/form-data">

                <div class="form-group row mb-4">
                    <div class="col-md-1">
                        <nop-label>فایل اکسل</nop-label>
                    </div>

                    <div class="col-md-11">
                        <div class="custom-file">
                            <input type="file"
                                   name="uploadFile"
                                   class="custom-file-input"
                                   id="uploadFile">
                            <label class="custom-file-label" for="uploadFile">
                                انتخاب فایل...
                            </label>
                        </div>

                        <small class="form-text text-muted mt-2">
                            @T("Admin.Orders.Shipments.ImportShipmentTrackNumber.ImportHint1")
                        </small>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-1">
                        <label class="control-label">  @T("Admin.Orders.Shipments.ImportShipmentTrackNumber.hint")</label>
                    </div>

                    <div class="col-md-11">
                        <div class="border rounded p-3 bg-light">

                            <div class="mb-2">
                                @T("Admin.Orders.Shipments.ImportShipmentTrackNumber.ImportHint2")
                            </div>

                            <ul class="mb-2">
                                <li>
                                    <strong>@_shipmentSettings.ShipmentIdIndicatorWordInFile</strong>
                                    (شماره مرسوله)
                                </li>
                                <li>
                                    <strong>@_shipmentSettings.TrackingNumberIndicatorWordInFile</strong>
                                    (کد رهگیری)
                                </li>
                            </ul>

                            <a class="btn btn-sm btn-outline-secondary"
                               href="@Url.Action("DownloadSample", "ShipmentTrackingNumberImport", new { area = "Admin" })"
                               download>
                                @T("Admin.Orders.Shipments.ImportShipmentTrackNumber.DownloadSampleFile")
                            </a>

                        </div>
                    </div>
                </div>

                <div class="form-group row mt-4">
                    <div class="col-md-9 offset-md-1">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-upload"></i>
                            @T("Admin.Common.UploadFile")
                        </button>
                    </div>
                </div>

            </form>

        </div>
    </div>

</div>

<script>
    document.querySelector('.custom-file-input')
        .addEventListener('change', function (e) {
            var fileName = e.target.files[0].name;
            e.target.nextElementSibling.innerText = fileName;
        });
</script>
