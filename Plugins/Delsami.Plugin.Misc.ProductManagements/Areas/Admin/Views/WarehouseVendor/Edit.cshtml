@model WarehouseVendorModel

@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("ZarIran.Plugin.Misc.ExtendedVendor.Warehousevendor.Edit").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("ZarIran.Plugin.Misc.ExtendedVendor.Warehousevendor.List.SystemName");
}

<form asp-controller="WarehouseVendor" asp-action="Edit" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("ZarIran.Plugin.Misc.ExtendedVendor.Warehousevendor.Edit")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">@T("ZarIran.Plugin.Misc.ExtendedVendor.Warehousevendor.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
            <span id="vendor-delete" class="btn btn-danger">
                <i class="far fa-trash-alt"></i>
                @T("Admin.Common.Delete")
            </span>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/ZarIran.Misc.ProductManagements/Areas/Admin/Views/WarehouseVendor/_CreateOrUpdate.cshtml", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="vendor-delete" />
