@model ZarIranShippingMethodStateProvinceRestrictionModel

<table class="table table-hover table-bordered">
    <script>
        $(document).ready(function () {
        @foreach (var sm in Model.AvailableShippingMethods)
        {
            <text>
                    prepareTableCheckboxes('#selectall-@(sm.Id)', '.restrict_@(sm.Id)');
            </text>
        }
        });

    </script>
    <thead>
        <tr>
            <th scope="col">
                <strong>@T("ZarIran.Plugin.Shipping.ManageShippingMethod.City")</strong>
            </th>
            @foreach (var sm in Model.AvailableShippingMethods)
            {
                <th scope="col">
                    <div class="checkbox">
                        <label>
                            <input type="checkbox" id="selectall-@(sm.Id)" />
                            <strong>@sm.Name</strong>
                        </label>
                    </div>
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.AvailableCities)
        {
            <tr>
                <td>
                    <span>@c.Name</span>
                </td>
                @foreach (var sm in Model.AvailableShippingMethods)
                {
                    var restricted = Model.Restricted.ContainsKey(c.Id) && Model.Restricted[c.Id][sm.Id];
                    <td>
                        <input class="restrict_@(sm.Id)" 
                               type="checkbox" 
                               value="@(c.Id)" 
                               name="restrict_@(sm.Id)" 
                               @(restricted ? " checked=checked" : null) />
                    </td>
                }
            </tr>
        }
    </tbody>
</table>