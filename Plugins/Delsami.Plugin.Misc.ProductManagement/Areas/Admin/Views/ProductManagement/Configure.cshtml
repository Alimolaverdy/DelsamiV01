@model Delsami.Plugin.Misc.ProductManagement.Areas.Admin.Models.Configurations.ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
    NopHtml.SetActiveMenuItemSystemName("ExtendedVendorConfiguration");
}

<form asp-controller="ProductManagement" asp-action="Configure" method="post">
    <section class="content">
        <div class="container-fluid">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="GroupedProductOrderBy" />
                            </div>
                            <div class="col-md-9">
                                <nop-select asp-for="GroupedProductOrderBy" asp-items="@await (((GroupedProductOrderBy)Model.GroupedProductOrderBy).ToSelectListAsync())" />
                                <span asp-validation-for="GroupedProductOrderBy"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="SortType" />
                            </div>
                            <div class="col-md-9">
                                <nop-select asp-for="SortType" asp-items="@await (((SortType)Model.SortType).ToSelectListAsync())" />
                                <span asp-validation-for="SortType"></span>
                            </div>
                        </div>

                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="BundleProductCategoryId" />
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="BundleProductCategoryId" asp-items="@Model.AvailableCategories" />
                            <span asp-validation-for="BundleProductCategoryId"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
</form>