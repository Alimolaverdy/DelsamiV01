@model DelsamiProductModel

<div class="card-body">
    <p>
        @T("Admin.Catalog.Products.BundleProducts.Hint")
    </p>
    @if (Model.Id > 0)
    {
        <div class="card card-default">
            <div class="card-body">

                @await Html.PartialAsync("Table", new DataTablesModel
       {
           Name = "bundleproducts-grid",
           UrlRead = new DataUrl("BundleProductList", "CustomProduct", new RouteValueDictionary { ["ProductId"] = Model.Id }),
           // UrlDelete = new DataUrl("BundleProductDelete", "CustomProduct", null),
           UrlUpdate = new DataUrl("BundleProductUpdate", "CustomProduct", null),
           Length = Model.RelatedProductSearchModel.PageSize,
           LengthMenu = Model.RelatedProductSearchModel.AvailablePageSizes,
           ColumnCollection = new List<ColumnProperty>
            {
            new ColumnProperty(nameof(BundleProductModel.Product2Name))
            {
            Title = T("Admin.Catalog.Products.BundleProduct.Fields.Product").Text
            },
            new ColumnProperty(nameof(BundleProductModel.Count))
            {
            Title = T("Admin.Catalog.Products.BundleProduct.Fields.Count").Text,
            Width = "150",
            ClassName = NopColumnClassDefaults.CenterAll,
            Editable = true,
            EditType = EditType.Number
            },
            new ColumnProperty(nameof(BundleProductModel.Price))
            {
                Title = T("Admin.Catalog.Products.BundleProduct.Fields.Price").Text,
                Width = "150",
                ClassName = NopColumnClassDefaults.CenterAll,
                Editable = true,
                EditType = EditType.Number
            },
            new ColumnProperty(nameof(BundleProductModel.ProductId2))
            {
            Title = T("Admin.Common.View").Text,
            Width = "150",
            ClassName = NopColumnClassDefaults.Button,
            Render = new RenderButtonView(new DataUrl("~/Admin/Product/Edit/", nameof(BundleProductModel.Product2Name)))
            },
            new ColumnProperty(nameof(BundleProductModel.Id))
            {
            Title = T("Admin.Common.Edit").Text,
            Width = "200",
            ClassName =  NopColumnClassDefaults.Button,
            Render = new RenderButtonsInlineEdit()
            }
            // ,
            // new ColumnProperty(nameof(BundleProductModel.Id))
            // {
            // Title = T("Admin.Common.Delete").Text,
            // Width = "100",
            // Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
            // ClassName = NopColumnClassDefaults.Button
            // }
            }
       })
            </div>
            <div class="card-footer">
                <button type="submit" id="btnAddNewRelatedProduct" class="btn btn-primary" onclick="javascript:OpenWindow('@(Url.Action("BundleProductAddPopup", "CustomProduct", new {productId = Model.Id, btnId = "btnRefreshBundleProducts", formId = "product-form"}))', 800, 800, true); return false;">
                    @T("Admin.Catalog.Products.BundleProducts.AddNew")
                </button>
                <button type="submit" id="btnRefreshBundleProducts" style="display: none"></button>
                <script>
                    $(document).ready(function () {
                        $('#btnRefreshBundleProducts').click(function () {
                            //refresh grid
                            updateTable('#bundleproducts-grid');

                            //return false to don't reload a page
                            return false;
                        });
                    });
                </script>
            </div>
        </div>
    }
    else
    {
        <div class="card card-default">
            <div class="card-body">
                @T("Admin.Catalog.Products.BundleProducts.SaveBeforeEdit")
            </div>
        </div>
    }
</div>