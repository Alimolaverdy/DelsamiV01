@model CustomerAttributeValidationSearchModel

@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("ZarIran.Plugin.Misc.CustomerAttributeValidator.CustomerAttributeValidation.List").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName(T("ZarIran.Plugin.Misc.CustomerAttributeValidator.CustomerAttributeValidation.List.SystemName").Text);

    const string hideSearchBlockAttributeName = "CustomerAttributeValidationPage.HideSearchBlock";

}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("ZarIran.Plugin.Misc.CustomerAttributeValidator.CustomerAttributeValidation.List")
    </h1>

    <div class="float-right">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-square"></i>
            @T("Admin.Common.AddNew")
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">

                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                        {
                        Name = "price-inquiries-grid",
                        UrlRead = new DataUrl("List", "CustomerAttributeValidation", new RouteValueDictionary{{"Area","Admin"}}),
                        SearchButtonId = "search-customer-attribute-validations",
                        Length = Model.PageSize,
                        LengthMenu = Model.AvailablePageSizes,
                        Filters = new List<FilterParameter>
                        {

                        },
                        ColumnCollection = new List<ColumnProperty>
                        {
                        new ColumnProperty(nameof(CustomerAttributeValidationModel.CustomerAttributeName))
                        {
                        Title = T("ZarIran.Plugin.Misc.CustomerAttributeValidator.CustomerAttributeValidation.Fields.CustomerAttributeId").Text,
                        ClassName =  NopColumnClassDefaults.CenterAll,
                        Width = "100"
                        },
                        new ColumnProperty(nameof(CustomerAttributeValidationModel.RegexPattern))
                        {
                        Title = T("ZarIran.Plugin.Misc.CustomerAttributeValidator.CustomerAttributeValidation.Fields.RegexPattern").Text,
                        ClassName =  NopColumnClassDefaults.CenterAll,
                        Width = "80"
                        },
                        new ColumnProperty(nameof(CustomerAttributeValidationModel.IsNationalCode))
                        {
                        Title = T("ZarIran.Plugin.Misc.CustomerAttributeValidator.CustomerAttributeValidation.Fields.IsNationalCode").Text,
                        Width = "80",
                        ClassName = NopColumnClassDefaults.CenterAll,
                        Render = new RenderBoolean()
                        },
                        new ColumnProperty(nameof(CustomerAttributeValidationModel.PreventFromShoppingInInvalidState))
                        {
                        Title = T("ZarIran.Plugin.Misc.CustomerAttributeValidator.CustomerAttributeValidation.Fields.PreventFromShoppingInInvalidState").Text,
                        Width = "80",
                        ClassName = NopColumnClassDefaults.CenterAll,
                        Render = new RenderBoolean()
                        },
                        new ColumnProperty(nameof(CustomerAttributeValidationModel.Active))
                        {
                        Title = T("ZarIran.Plugin.Misc.CustomerAttributeValidator.CustomerAttributeValidation.Fields.Active").Text,
                        Width = "80",
                        ClassName = NopColumnClassDefaults.CenterAll,
                        Render = new RenderBoolean()
                        } ,
                        new ColumnProperty(nameof(CustomerAttributeValidationModel.Id))
                        {
                        Title = T("Admin.Common.Edit").Text,
                        Width = "80",
                        ClassName =  NopColumnClassDefaults.Button,
                        Render = new RenderButtonEdit(new DataUrl("Edit"))
                        }
                        }
                        })

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

