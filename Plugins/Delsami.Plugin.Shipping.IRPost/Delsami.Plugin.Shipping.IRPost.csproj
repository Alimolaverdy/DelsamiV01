<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<Copyright>SOME_COPYRIGHT</Copyright>
		<Company>Delsami</Company>
		<Authors>AliMolaverdi</Authors>
		<PackageLicenseUrl>PACKAGE_LICENSE_URL</PackageLicenseUrl>
		<PackageProjectUrl>PACKAGE_PROJECT_URL</PackageProjectUrl>
		<RepositoryUrl>REPOSITORY_URL</RepositoryUrl>
		<RepositoryType>Git</RepositoryType>
		<OutputPath>..\..\Presentation\Nop.Web\Plugins\Delsami.Shipping.IRPost</OutputPath>
		<OutDir>$(OutputPath)</OutDir>
		<!--Set this parameter to true to get the dlls copied from the NuGet cache to the output of your project. You need to set this parameter to true if your plugin has a nuget package to ensure that the dlls copied from the NuGet cache to the output of your project-->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<ClearPluginAssemblies Include="$(MSBuildProjectDirectory)\..\..\Build\ClearPluginAssemblies.proj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Presentation\Nop.Web\Nop.Web.csproj">
			<Private>False</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Delsami.Plugin.Misc.Core">
			<HintPath>..\..\Presentation\Nop.Web\Plugins\Delsami.Misc.Core\Delsami.Plugin.Misc.Core.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Delsami.Plugin.Shipping.Core">
		  <HintPath>..\..\Presentation\Nop.Web\Plugins\Delsami.Shipping.Core\Delsami.Plugin.Shipping.Core.dll</HintPath>
		  <Private>False</Private>
		</Reference>
		<Reference Include="Delsami.Plugin.Widgets.AddressLocation">
			<HintPath>..\..\Presentation\Nop.Web\Plugins\Delsami.Widgets.AddressLocation\Delsami.Plugin.Widgets.AddressLocation.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Delsami.Plugin.Payment.Core">
			<HintPath>..\..\Presentation\Nop.Web\Plugins\Delsami.Payment.Core\Delsami.Plugin.Payment.Core.dll</HintPath>
			<Private>False</Private>
		</Reference>
	  <Reference Include="Delsami.Plugin.Misc.Core">
	    <HintPath>..\..\Presentation\Nop.Web\Plugins\Delsami.Misc.Core\Delsami.Plugin.Misc.Core.dll</HintPath>
	    <Private>False</Private>
	  </Reference>
	  <Reference Include="Delsami.Plugin.Widgets.AddressLocation">
	    <HintPath>..\..\Presentation\Nop.Web\Plugins\Delsami.Widgets.AddressLocation\Delsami.Plugin.Widgets.AddressLocation.dll</HintPath>
	  </Reference>
	</ItemGroup>

	<ItemGroup>
		<!-- Views - using Content for proper deployment -->
		<Content Include="Areas\Admin\Views\IRPost\Configure.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Areas\Admin\Views\PriceRange\List.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Areas\Admin\Views\PriceRange\Create.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Areas\Admin\Views\PriceRange\Edit.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Areas\Admin\Views\PriceRange\_CreateOrUpdate.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Areas\Admin\Views\_ViewImports.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Plugin.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- This target execute after "Build" target -->
	<Target Name="NopTarget" AfterTargets="Build">
		<!-- Delete unnecessary libraries from plugins path -->
		<MSBuild Projects="@(ClearPluginAssemblies)" Properties="PluginPath=$(MSBuildProjectDirectory)\$(OutDir)" Targets="NopClear" />
	</Target>
</Project>