<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<Copyright>Copyright ©, Ltd</Copyright>
		<Authors>Gerardo Tous</Authors>
		<PackageLicenseUrl></PackageLicenseUrl>
		<OutputPath>..\..\Presentation\Nop.Web\Plugins\Misc.AdvRedirect</OutputPath>
		<OutDir>$(OutputPath)</OutDir>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="Migrations\**" />
		<Compile Remove="PackageFiles\**" />
		<EmbeddedResource Remove="Migrations\**" />
		<EmbeddedResource Remove="PackageFiles\**" />
		<None Remove="Migrations\**" />
		<None Remove="PackageFiles\**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Areas\Admin\Views\List.cshtml" />
		<None Remove="logo.jpg" />
		<None Remove="plugin.json" />
		<None Remove="Areas\Admin\Views\_ViewImports.cshtml" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="logo.jpg">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="plugin.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ClearPluginAssemblies Include="$(MSBuildProjectDirectory)\..\..\Build\ClearPluginAssemblies.proj" />
	</ItemGroup>

	<!--E:\Fuentes\nopcommerce\nopCommerce-release-4.60\Build\ClearPluginAssemblies.proj-->

	<ItemGroup>
		<Content Include="logo.jpg">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Areas\Admin\Views\RedirectionRule\List.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Areas\Admin\Views\_ViewImports.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="30.0.1" />
		<PackageReference Include="ClosedXML" Version="0.97.0" />

	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Presentation\Nop.Web\Nop.Web.csproj">
			<Private>False</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="Delsami.Plugin.Misc.Core">
	    <HintPath>..\..\Presentation\Nop.Web\Plugins\Delsami.Misc.Core\Delsami.Plugin.Misc.Core.dll</HintPath>
	    <Private>False</Private>
	  </Reference>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Areas\Admin\Views\AdvRedirect\Configure.cshtml">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<!-- This target execute after "Build" target -->
	<Target Name="NopTarget" AfterTargets="Build">
		<!-- Delete unnecessary libraries from plugins path -->
		<MSBuild Projects="@(ClearPluginAssemblies)" Properties="PluginPath=$(MSBuildProjectDirectory)\$(OutDir)" Targets="NopClear" />
	</Target>

</Project>
