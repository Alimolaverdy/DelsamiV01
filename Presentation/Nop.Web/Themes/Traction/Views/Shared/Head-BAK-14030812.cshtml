@using Nop.Core
@using Nop.Core.Domain.Catalog

@inject CatalogSettings catalogSettings
@inject IWorkContext workContext

@{

    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;

    if (supportRtl)
    {
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/1280.rtl.css");
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/1024.rtl.css");
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/768.rtl.css");
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/480.rtl.css");
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/mobile.rtl.css");
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/tables.rtl.css");
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/styles.rtl.css");

        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/NobParts-custom-styles.rtl.css");

    }
    else
    {
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/1280.css");
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/1024.css");
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/768.css");
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/480.css");
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/mobile.css");
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/tables.css");
        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/styles.css");


    }

        NopHtml.AppendCssFileParts("~/Themes/Traction/Content/css/bootstrap-icons.min.css");
    

    if (catalogSettings.DisplayAllPicturesOnCatalogPages)
    {
        NopHtml.AppendCssFileParts("~/lib_npm/swiper/swiper-bundle.min.css");
    }

    NopHtml.AppendCssFileParts("~/Plugins/SevenSpikes.Core/Styles/perfect-scrollbar.min.css");

    <script src="~/Plugins/SevenSpikes.Core/Scripts/footable.min.js" asp-location="Footer"></script>
    <script src="~/Plugins/SevenSpikes.Core/Scripts/perfect-scrollbar.min.js" asp-location="Footer"></script>
    <script src="~/Plugins/SevenSpikes.Core/Scripts/sevenspikes.core.min.js" asp-location="Footer"></script>
    <script src="~/Plugins/SevenSpikes.Core/Scripts/sevenspikes.theme.ex.min.js" asp-location="Footer"></script>

    <script src="~/Themes/Traction/Content/scripts/traction.js" asp-location="Footer"></script>


<script>
    $(document).ready(function () {
        $('.btn-close').hide();
        $('.small-searchterms-mob').focus(function () {
            $('#search').animate({
                "width": "360px",
            });
            $('#search').addClass('active');
            $('.overlay').fadeIn();
            $('.btn-close').fadeIn();
            //$('.btn-close').css("display", "inline-block !important");
        });
        $('.overlay,.btn-close').click(function () {
            $('#search').animate({
                "width": "300px",
            });
            $('#search').removeClass('active');
            $('.overlay').fadeOut();
            $('.btn-close').hide();
        });
    });
</script>
}