    <!-- Popup -->

    <div id="npPopup"
         class="npPopup np-discountoffer-content d-none">

        <div class="np-popup-overlay"
             onclick="npClosePopup()">
        </div>


        <div class="np-popup-card"
             role="dialog"
             aria-modal="true">

            <button type="button"
                    class="np-popup-close"
                    aria-label="بستن پنجره"
                    onclick="npClosePopup()">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M18 6L6 18M6 6l12 12"></path>

                </svg>

            </button>


            <div class="np-popup-content">

                <h2 class="np-popup-title"></h2>

                <p class="np-popup-description"></p>

                <div class="np-popup-actions"></div>

            </div>

        </div>

    </div>


    <script asp-location="None">

        function npRenderDiscountCodes() {

            const container = document.querySelector(".np-popup-actions");

            if (!container) {
                return;
            }

            container.innerHTML = npDiscountCodes.map(function (item) {
                if (!item.enabled) return;

                return `
                        <div class="np-discount-item ${item.className}">

                            <div class="np-discount-item-header">
                                <img src="${item.logo}"
                                     alt="${item.providerTitle}" />

                                <span>${item.providerTitle}</span>
                            </div>

                            <div class="np-discount-code-container">

                                <div class="np-discount-code-description">

                                    <div class="np-discount-code-description-title">
                                        ${item.discountTitle}
                                    </div>

                                    <div class="np-discount-code-description-text">
                                        ${item.discountDescription}
                                    </div>

                                </div>

                                <div class="np-discount-code">

                                    <button type="button"
                                            class="np-copy-button"
                                            onclick="npCopyDiscountCode(this)">

                                        <span class="discountCode">
                                            ${item.code}
                                        </span>

                                        <span class="np-copy-icon">

                                            <svg width="24"
                                                 height="24"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 xmlns="http://www.w3.org/2000/svg">

                                                <path
                                                    d="M15 11.3235V16.6765C15 19.7647 13.8 21 10.8 21H7.2C4.2 21 3 19.7647 3 16.6765V11.3235C3 8.23529 4.2 7 7.2 7H10.8C13.8 7 15 8.23529 15 11.3235Z"
                                                    stroke="#2E3192"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round" />

                                                <path
                                                    d="M21 7V12.9647C21 15.8471 19.8 17 16.8 17H15C15 17 15 13.8588 15 10.9765C15 8.09412 13.6571 6.94118 10.6571 6.94118H9C9 4.05882 10.2 3 13.2 3H16.8C19.8 3 21 4.11765 21 7Z"
                                                    stroke="#2E3192"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round" />

                                            </svg>

                                        </span>

                                    </button>

                                </div>

                            </div>

                        </div>
                    `;

            }).join("");
        }

        function npRenderPopupContent() {

            const titleElement = document.querySelector(".np-popup-title");
            const descriptionElement = document.querySelector(".np-popup-description");

            if (titleElement) {
                titleElement.textContent = npPopupSettings.title;
            }

            if (descriptionElement) {
                descriptionElement.textContent = npPopupSettings.description;
            }
        }

        function npClosePopup() {

            const popup = document.querySelector(".npPopup");

            if (popup) {
                popup.classList.add("d-none");
            }
        }


        function npShowPopup() {
            jQuery("#npPopup").removeClass("d-none");
        }


        async function npCopyDiscountCode(button) {

            const codeElement = button.querySelector("span.discountCode");

            if (!codeElement) {
                return;
            }

            const code = codeElement.textContent.trim();

            try {

                await navigator.clipboard.writeText(code);

            } catch (error) {

                const input = document.createElement("textarea");

                input.value = code;
                input.style.position = "fixed";
                input.style.opacity = "0";

                document.body.appendChild(input);

                input.select();
                document.execCommand("copy");

                input.remove();
            }

            button.classList.add("np-copied");

            setTimeout(function () {

                button.classList.remove("np-copied");

            }, 1800);
        }


        function npCopyDiscountCodeCheckout(button) {

            const codeElement = button.querySelector(".np-discount-code");

            if (!codeElement) {
                return;
            }

            const code = codeElement.textContent.trim();

            const input = document.createElement("textarea");

            input.value = code;
            input.style.position = "fixed";
            input.style.opacity = "0";

            document.body.appendChild(input);

            input.select();
            document.execCommand("copy");

            input.remove();

            button.classList.add("np-copied");

            setTimeout(function () {

                button.classList.remove("np-copied");

            }, 1800);
        }



        document.addEventListener("keydown", function (event) {

            if (event.key === "Escape") {
                npClosePopup();
            }

        });


        function npSetCookie(name, value, maxAge) {

            const cookie =
                `${encodeURIComponent(name)}=${encodeURIComponent(value)}; ` +
                `Max-Age=${maxAge}; Path=/; SameSite=Lax`;

            document.cookie = cookie;
        }


        function npGetCookie(name) {

            const encodedName = encodeURIComponent(name) + "=";
            const cookies = document.cookie.split(";");

            for (const cookieItem of cookies) {

                const cookie = cookieItem.trim();

                if (cookie.startsWith(encodedName)) {

                    return decodeURIComponent(
                        cookie.substring(encodedName.length)
                    );

                }
            }

            return null;
        }


        function activateListenerInterval() {

            const copyListenerInterval = setInterval(function () {

                const buttons = document.querySelectorAll(
                    ".np-checkout-discount-card .np-copy-button"
                );

                if (!buttons.length) {
                    return;
                }

                buttons.forEach(function (button) {

                    /*
                     * جلوگیری از اضافه شدن چند Listener
                     */
                    if (button.dataset.npCopyListener === "true") {
                        return;
                    }

                    button.dataset.npCopyListener = "true";

                    button.addEventListener("click", function () {
                        npCopyDiscountCodeCheckout(this);
                    });

                });

                clearInterval(copyListenerInterval);

            }, 500);
        }


        function observeElement(selector) {

            const element = document.querySelector(selector);

            if (!element) {

                console.warn("Element not found:", selector);
                return;

            }

            const contentObserver = new MutationObserver((mutations) => {

                element.dispatchEvent(
                    new CustomEvent("elementChanged", {
                        detail: mutations
                    })
                );

            });

            contentObserver.observe(element, {
                childList: true,
                subtree: true,
                attributes: true,
                characterData: true
            });


            const removalObserver = new MutationObserver(() => {

                if (!element.isConnected) {

                    document.dispatchEvent(
                        new CustomEvent("elementRemoved", {
                            detail: {
                                element,
                                selector
                            }
                        })
                    );

                    contentObserver.disconnect();
                    removalObserver.disconnect();
                }

            });

            removalObserver.observe(document.body, {
                childList: true,
                subtree: true
            });


            return {

                stop() {

                    contentObserver.disconnect();
                    removalObserver.disconnect();

                }

            };
        }


        jQuery(document).ready(function () {

            npRenderPopupContent();
            npRenderDiscountCodes();


            let popupStatus = npGetCookie("popupStatus");
            let allwaysOnPopup = false;

            if (popupStatus !== "false" || allwaysOnPopup) {

                npShowPopup();

                npSetCookie(
                    "popupStatus",
                    "false",
                    10 * 60
                );

            }

            if (window.location.pathname === "/onepagecheckout") {
                activateListenerInterval();
            }

        });

    </script>
</body>
</html>
