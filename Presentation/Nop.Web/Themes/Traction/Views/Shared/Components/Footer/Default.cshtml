@model FooterModel
@using Nop.Core.Domain.Topics
<footer class="footer zar-footer">
    <div class="np-container zar-footer-grid">
        <div class="zar-footer-brand">@await Html.PartialAsync("_ZarBrand")<p>طلاهای ظریف برای لحظه‌هایی که ماندگار می‌شوند.</p><a class="zar-text-link" href="@Url.RouteUrl("ContactUs")">همراه شما در انتخاب و خرید ←</a></div>
        <div class="footer-block"><div class="title"><strong>خرید از زر ایران</strong></div><ul>
            @if (Model.SearchEnabled && Model.DisplayProductSearchFooterItem) { <li><a href="@Url.RouteUrl("ProductSearch")">@T("Search")</a></li> }
            @if (Model.NewProductsEnabled && Model.DisplayNewProductsFooterItem) { <li><a href="@Url.RouteUrl("NewProducts")">@T("Products.NewProducts")</a></li> }
            @if (Model.DisplayCustomerOrdersFooterItem) { <li><a href="@Url.RouteUrl("CustomerOrders")">@T("Account.CustomerOrders")</a></li> }
            @foreach (var topic in Model.Topics.Where(x => x.IncludeInFooterColumn1)) { <li><a href="@(Url.RouteUrl<Topic>(new { SeName = topic.SeName }))">@topic.Name</a></li> }
        </ul></div>
        <div class="footer-block"><div class="title"><strong>راهنما و خدمات</strong></div><ul>
            @if (Model.DisplayCustomerInfoFooterItem) { <li><a href="@Url.RouteUrl("CustomerInfo")">@T("Account.MyAccount")</a></li> }
            @if (Model.DisplayContactUsFooterItem) { <li><a href="@Url.RouteUrl("ContactUs")">@T("ContactUs")</a></li> }
            @if (Model.SitemapEnabled && Model.DisplaySitemapFooterItem) { <li><a href="@Url.RouteUrl("Sitemap")">@T("Sitemap")</a></li> }
            @foreach (var topic in Model.Topics.Where(x => x.IncludeInFooterColumn2 || x.IncludeInFooterColumn3)) { <li><a href="@(Url.RouteUrl<Topic>(new { SeName = topic.SeName }))">@topic.Name</a></li> }
        </ul></div>
    </div>
    <div class="np-container zar-footer-certificates">@await Component.InvokeAsync("Widget", new { widgetZone = "footer-certificates-container" })</div>
    <div class="np-container zar-footer-bottom"><span>تمام حقوق برای @Model.StoreName محفوظ است.</span>@await Component.InvokeAsync(typeof(SocialButtonsViewComponent))@if (!Model.HidePoweredByNopCommerce) { <span>Powered by <a href="https://www.nopcommerce.com/">nopCommerce</a></span> }</div>
</footer>
