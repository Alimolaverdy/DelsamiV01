@model List<SevenSpikes.Nop.Plugins.JCarousel.Models.JCarouselModel>

@inject IThemeContext themeContext
@inject IWorkContext workContext
@inject ISettingService settingService
@inject IStoreContext storeContext
@inject ILogger logger
@inject SevenSpikes.Nop.Plugins.JCarousel.Services.IItemsMappingService itemsMappingService
@inject Nop.Services.Localization.ILocalizationService localizationService
@inject Nop.Services.Seo.IUrlRecordService urlRecordService
@inject Nop.Services.Media.IPictureService pictureService
@inject Nop.Services.Catalog.IProductService productService
@inject Delsami.Plugin.Misc.Core.Services.IVirtualProductMappingService virtualProductMappingService
@inject Nop.Core.Domain.Media.MediaSettings mediaSettings

@{
    var currentThemeName = await themeContext.GetWorkingThemeNameAsync();

    var jCarouselCssFilePath = "~/Plugins/SevenSpikes.Nop.Plugins.JCarousel/Themes/" + currentThemeName + "/Content/JCarousel.css";

    bool supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;

    string controllerName = Url.ActionContext.RouteData.Values["controller"]?.ToString();
    string actionName = Url.ActionContext.RouteData.Values["action"]?.ToString();
    var isHomePage = string.Equals(controllerName, "home", StringComparison.OrdinalIgnoreCase) &&
             string.Equals(actionName, "index", StringComparison.OrdinalIgnoreCase);
}

<link rel="stylesheet" href="~/Plugins/SevenSpikes.Nop.Plugins.JCarousel/Styles/slick.css" />
<link rel="stylesheet" href="@jCarouselCssFilePath" />

@if (supportRtl)
{
    var jCarouselRtlCssFilePath = "~/Plugins/SevenSpikes.Nop.Plugins.JCarousel/Themes/" + currentThemeName + "/Content/JCarousel.rtl.css";

    <link rel="stylesheet" href="@jCarouselRtlCssFilePath" />
}

<script src="~/Plugins/SevenSpikes.Core/Scripts/sevenspikes.core.min.js" asp-location="Footer"></script>
<script src="~/Plugins/SevenSpikes.Core/Scripts/swipeEvents.min.js" asp-location="Footer"></script>
<script src="~/Plugins/SevenSpikes.Core/Scripts/slick-slider-1.6.0.min.js" asp-location="Footer"></script>
<script src="~/Plugins/SevenSpikes.Nop.Plugins.JCarousel/Scripts/jCarousel.min.js" asp-location="Footer"></script>

@foreach (var carousel in Model)
{
    if (carousel.Items.Count < 1)
    {
        continue;
    }

    var homePageCategoryClass = string.Empty;

    if (carousel.DataSourceTypeClass == "category-grid")
    {
        if (isHomePage)
        {
            homePageCategoryClass = "home-page-category-grid";
        }
        else
        {
            homePageCategoryClass = "sub-category-grid";
        }
    }

    var homePageProductGridClass = string.Empty;

    if (carousel.DataSourceTypeClass == "product-grid")
    {
        if (isHomePage)
        {
            homePageProductGridClass = "home-page-product-grid";
        }
    }

    var useHomeProductLayout = isHomePage && carousel.DataSourceTypeClass == "product-grid" &&
        string.Equals(currentThemeName, "Traction", StringComparison.OrdinalIgnoreCase);
    var category = useHomeProductLayout
        ? (await itemsMappingService.GetCategoriesMappedToTheJCarouselAsync(carousel.Settings.Id)).FirstOrDefault()
        : null;
    var carouselLayoutClass = useHomeProductLayout ? "Delsami-home-carousel" : string.Empty;
    var productWeights = new Dictionary<int, (decimal Minimum, decimal Maximum)>();
    if (carousel.DataSourceTypeClass == "product-grid" &&
        string.Equals(currentThemeName, "Traction", StringComparison.OrdinalIgnoreCase))
    {
        var missingWeightIds = carousel.Items.Select(item => item.ProductOverviewModel)
            .Where(product => product != null && product.Weight <= 0)
            .Select(product => product.Id).Distinct().ToArray();

        if (missingWeightIds.Length > 0)
        {
            var store = await storeContext.GetCurrentStoreAsync();
            foreach (var product in await productService.GetProductsByIdsAsync(missingWeightIds))
            {
                if (product.Weight > 0)
                {
                    productWeights[product.Id] = (product.Weight, product.Weight);
                }
                else if (product.ProductType == Nop.Core.Domain.Catalog.ProductType.GroupedProduct)
                {
                    var variants = await productService.GetAssociatedProductsAsync(product.Id, store.Id);
                    var weights = new List<decimal>();
                    foreach (var variant in variants)
                    {
                        var mapping = await virtualProductMappingService.GetMainProductByVirtualProductIdAsync(variant.Id);
                        var weight = mapping.IsVirtualPrdocut ? mapping.MainProduct?.Weight ?? 0 : variant.Weight;
                        if (weight > 0)
                            weights.Add(weight);
                    }

                    if (weights.Count > 0)
                        productWeights[product.Id] = (weights.Min(), weights.Max());
                }
            }
        }
    }


    var loopItems = carousel.Settings.JCarouselEntitySettings.LoopItems;
    var numberOfItemsToShow = carousel.Settings.JCarouselEntitySettings.NumberOfVisibleItems < 1 ? 1 : carousel.Settings.JCarouselEntitySettings.NumberOfVisibleItems;
    var numOfSlidesToScroll = carousel.Settings.JCarouselEntitySettings.ScrollItems;
    var navigationDots = carousel.Settings.JCarouselEntitySettings.NavigationDots;
    var animationSpeedString = carousel.Settings.JCarouselEntitySettings.AnimationSpeed;
    var animationSpeed = 0;
    var autoscrollTimeout = carousel.Settings.JCarouselEntitySettings.Autoscroll;
    var autoscroll = autoscrollTimeout > 0;
    var navigationArrows = carousel.Settings.JCarouselEntitySettings.NavigationArrows;
    var initialSlide = carousel.Settings.JCarouselEntitySettings.StartIndex - 1;
    var pauseOnHover = carousel.Settings.JCarouselEntitySettings.AutoscrollHoverPause;
    var prevArrowHtml = "<button type=\"button\" data-role=\"none\" class=\"slick-prev\" aria-label=\"Previous\" tabindex=\"0\" role=\"button\">" + T("SevenSpikes.JCarousel.Public.PreviousArrow") + "</button>";
    var nextArrowHtml = "<button type=\"button\" data-role=\"none\" class=\"slick-next\" aria-label=\"Next\" tabindex=\"0\" role=\"button\">" + T("SevenSpikes.JCarousel.Public.NextArrow") + "</button>";
    var arrowsSelector = useHomeProductLayout ? ".carousel-title" : carousel.NavigationArrowsSelector;
    var carouselArrowsContainer = "#" + carousel.Settings.CarouselHtmlElementId + " " + arrowsSelector;

    switch (animationSpeedString)
    {
        case "slow":
            animationSpeed = 300;

            break;
        case "fast":
            animationSpeed = 150;

            break;
    }

    var responsiveBreakpointJson = carousel.ResponsiveBreakpoints;

    IList<ResponsiveBreakpointDTO> responsiveBreakPoints = new List<ResponsiveBreakpointDTO>();

    try
    {
        responsiveBreakPoints = JsonConvert.DeserializeObject<IList<ResponsiveBreakpointDTO>>(responsiveBreakpointJson);

        var responsiveBreakpoint = new ResponsiveBreakpointDTO
                    {
                        Breakpoint = 10000,
                        Settings = new Dictionary<string, object>()
                    };

        responsiveBreakpoint.Settings.TryAdd("slidesToShow", numberOfItemsToShow);

        responsiveBreakPoints.Insert(0, responsiveBreakpoint);

        foreach (var breakpoint in responsiveBreakPoints)
        {
            if (breakpoint.Settings.ContainsKey("slidesToShow"))
            {
                var slidesToShow = int.Parse(breakpoint.Settings["slidesToShow"].ToString());

                if (slidesToShow < numOfSlidesToScroll)
                {
                    if (breakpoint.Settings.ContainsKey("slidesToScroll"))
                    {
                        breakpoint.Settings.Remove("slidesToScroll");
                    }

                    breakpoint.Settings.Add("slidesToScroll", slidesToShow);
                }
            }
        }
    }
    catch (Exception e)
    {
        await logger.ErrorAsync("Invalid slick slider responsive breakpoints setting value!", e);
    }

    var slickSettingsDictionary = new Dictionary<string, object>
    {
            {"rtl", supportRtl},
            {"infinite", loopItems},
            {"slidesToScroll", numOfSlidesToScroll},
            {"dots", navigationDots},
            {"speed", animationSpeed},
            {"autoplay", autoscroll},
            {"autoplaySpeed", autoscrollTimeout * 1000},
            {"arrows", navigationArrows},
            {"appendArrows", carouselArrowsContainer},
            {"cssEase", "linear"},
            {"respondTo", "slider"},
            {"edgeFriction", 0.05},
            {"initialSlide", initialSlide},
            {"pauseOnHover", pauseOnHover},
            {"draggable", false},
            {"prevArrow", prevArrowHtml},
            {"nextArrow", nextArrowHtml},
            {"responsive", responsiveBreakPoints},
            {"lazyLoad", "ondemand"}
    };

    var slickSettingsJson = JsonConvert.SerializeObject(slickSettingsDictionary, Formatting.None);

    <div id="@carousel.Settings.CarouselHtmlElementId" class="jCarouselMainWrapper @carouselLayoutClass @carousel.Settings.JCarouselEntitySettings.Skin">
        @if (category != null)
        {
            var categoryName = await localizationService.GetLocalizedAsync(category, x => x.Name);
            var categorySlug = await urlRecordService.GetSeNameAsync(category);
            var categoryUrl = Url.RouteUrl("Category", new { SeName = categorySlug });
            var categoryImage = await pictureService.GetPictureUrlAsync(
                category.PictureId, mediaSettings.CategoryThumbPictureSize, showDefaultPicture: false);

            <a class="Delsami-carousel-category" href="@categoryUrl">
                @if (!string.IsNullOrEmpty(categoryImage))
                {
                    <img src="@categoryImage" alt="" loading="lazy" />
                }
                <strong>@categoryName</strong>
                <span>@(supportRtl ? "مشاهده همه" : "View all")</span>
            </a>
        }
        <div class="nop-jcarousel @carousel.DataSourceTypeClass @homePageCategoryClass @homePageProductGridClass">

            <div class="title carousel-title">
                @if ((category == null || !useHomeProductLayout) &&
                    !string.IsNullOrEmpty(carousel.Settings.Title) && carousel.Settings.JCarouselEntitySettings.ShowTitle)
                {
                    <h3><strong>@carousel.Settings.Title</strong></h3>
                }
                else if (!useHomeProductLayout)
                {
                    <text>&nbsp;</text>
                }
            </div>

            <div class="slick-carousel item-grid" data-slick='@slickSettingsJson' data-numberOfVisibleItems="@numberOfItemsToShow">
                @foreach (var item in carousel.Items)
                {
                    <div class="carousel-item">
                        <div class="item-box">
                            @switch (carousel.DataSourceTypeClass)
                            {
                                case "product-grid":
                                    @await Html.PartialAsync("_ProductBox", item.ProductOverviewModel, new ViewDataDictionary(ViewData)
                                    {
                                        ["IsHomeCarouselProduct"] = useHomeProductLayout,
                                        ["CarouselProductWeights"] = productWeights.TryGetValue(item.ProductOverviewModel.Id, out var weights)
                                            ? weights
                                            : (item.ProductOverviewModel.Weight, item.ProductOverviewModel.Weight)
                                    })
                                    break;
                                case "category-grid":
                                    @await Component.InvokeAsync("JCarouselCategoryBox", item.CategoryModel)
                                    break;
                                case "manufacturer-grid":
                                    @await Component.InvokeAsync("JCarouselManufacturerBox", item.ManufacturerModel)
                                    break;
                                case "vendor-grid":
                                    @await Component.InvokeAsync("JCarouselVendorBox", item.VendorModel)
                                    break;
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}