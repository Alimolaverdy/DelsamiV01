@model DateTime
@using System.Globalization
@using Nop.Core
@using Nop.Core.Infrastructure
@{
    //var lan = (await EngineContext.Current.Resolve<IWorkContext>().GetWorkingLanguageAsync()).UniqueSeoCode;
    string lan = "fa";

    NopHtml.AppendCssFileParts("~/Plugins/NopShop.Misc.Calendare/Content/css/jquery.md.bootstrap.datetimepicker.style.css");
    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/Plugins/NopShop.Misc.Calendare/Content/js/jquery.md.bootstrap.datetimepicker.js", "");
}

@if (lan == "fa")
{
    <div class="input-group">
        <div class="input-group-prepend">
            <span class="input-group-text cursor-pointer" id="@Html.IdForModel()-date">
                <i class="far fa-calendar"></i>
            </span>
        </div>
        <input type="text" id="@Html.IdForModel()" name="@Html.IdForModel()" class="form-control" aria-label="@Html.IdForModel()-date"
               aria-describedby="@Html.IdForModel()-date">
    </div>
    <hr>

    <script>
        $('#@Html.IdForModel()-date').MdPersianDateTimePicker({
            targetTextSelector: '#@Html.IdForModel()',
            enableTimePicker: true,
            modalMode: false,
            englishNumber: true,
            selectedDate: new Date('@Model.ToString(CultureInfo.InvariantCulture)')
        });
    </script>
}
else
{
    <input id="@Html.IdForModel()" name="@Html.NameForModel()" value="@((Model > DateTime.MinValue ? Model : DateTime.Today).ToString())" />
    <script>
        $(document).ready(function () {
            $("#@Html.IdForModel()").kendoDateTimePicker({
                popup: {
                    position: "bottom right",
                    origin: "top right"
                }
            });
        });
    </script>
     <style>
    .input-group-prepend {
        height: 38px !important;
    }

    .mds-bootstrap-persian-datetime-picker-popover {
        max-width: 100% !important;
        right: unset !important;
    }
</style>

}
